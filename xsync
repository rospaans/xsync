BUTTON_CAP, BUTTON_CAP_ON, BUTTON_CAP_ALERT = "1;38;5;16;48;5;252", "1;38;5;16;48;5;78", "1;38;5;16;48;5;176"
BUTTON_LABEL = "38;5;255;48;5;238"
BUTTON_GAP = 2


def styled(segments: list[tuple[str, str]], background: str = "") -> str:
    """Join (text, color code) pairs into one string; plain text when colors are off."""
    if not colors_on():
        return "".join(text for text, _ in segments)
    out = ""
    for text, code in segments:
        codes = ";".join(part for part in ("0", background, code) if part)
        out += f"\033[{codes}m{text}"
    return out + "\033[0m"


def segments_length(segments: list[tuple[str, str]]) -> int:
    return sum(len(text) for text, _ in segments)


def clip_segments(segments: list[tuple[str, str]], width: int) -> list[tuple[str, str]]:
    """Cut segments off at width characters, as a last resort on a tiny terminal."""
    clipped = []
    for text, code in segments:
        room = width - segments_length(clipped)
        if room <= 0:
            break
        clipped.append((text[:room], code))
    return clipped


def spread(left: list[tuple[str, str]], right: list[tuple[str, str]], width: int) -> list[tuple[str, str]]:
    """Put left and right segments at the two ends of a row of exactly width characters."""
    gap = max(width - segments_length(left) - segments_length(right), 0)
    row = clip_segments(left + [(" " * gap, "")] + right, width)
    return row + [(" " * (width - segments_length(row)), "")]


class Panel:
    """The rows fixed at the top of a view: a status bar, a grid of buttons and a message line."""

    def __init__(self, name: str, keys: list[list[tuple[str, str]]], remote: str = "", transport: str = ""):
        self.name, self.remote, self.transport = name, remote, transport
        self.keys = keys
        self.mode, self.state, self.level, self.detail = "idle", "starting…", "busy", ""
        self.switches: dict[str, bool] = {}   # on/off buttons, by key
        self.message, self.message_color = "", "dim"

    def bar(self, width: int, badge: tuple[str, str] | None = None) -> str:
        """The mode badge, what is synced where, and on the right the current state."""
        badge = badge or (f" {BAR_LABEL[self.mode]} ", BAR_BADGE[self.mode])
        left = [badge, (f"  {self.name}", "1;97")]
        if self.remote:
            left += [("  →  ", "38;5;250"), (f" {self.transport.upper()} ", BAR_TRANSPORT),
                     (f" {self.remote}", "38;5;250")]
        right = [("●", BAR_DOT[self.level]), (f" {self.state}", "38;5;255")]
        # detail is "N changes · last HH:MM:SS": the count as a tag, the time after it
        count, _, last = self.detail.partition(" · ")
        extras = []
        if count:
            extras += [("   ", ""), (f" {count} ", BAR_TAG)]
        if last:
            extras.append((f"  {last}", "38;5;250"))
        right += extras + [(" ", "")]

        # Too narrow: drop the time, then the count, then shorten the remote, then the state
        while extras and segments_length(left) + 2 + segments_length(right) > width:
            extras.pop()
            if extras and extras[-1][0] == "   ":
                extras.pop()
            right = right[:2] + extras + [(" ", "")]
        if self.remote:
            room = width - segments_length(left[:4]) - 2 - segments_length(right)
            if len(left[4][0]) > room:
                left[4] = (left[4][0][:max(room - 1, 0)] + "…" if room > 0 else "", left[4][1])
        over = segments_length(left) + segments_length(right) - width
        if over > 0:
            right[1] = (right[1][0][:max(len(right[1][0]) - over, 0)], right[1][1])
        while len(left) > 1 and segments_length(left) + segments_length(right) > width:
            left.pop()
        return styled(spread(left, right, width), BAR_BACKGROUND)

    def key_rows(self, width: int) -> list[str]:
        """The keys as a grid of equal-width buttons.

        As many columns as fit with full labels; a narrower terminal gets fewer
        columns and more rows, down to one button per line.
        """
        plain = not colors_on()
        keys = [item for row in self.keys for item in row]
        cap_width = 4 if plain else 3   # "[s] " or " s "
        longest = max(len(label) + (len(" off") if key in self.switches else 0) for key, label in keys)
        label_width = longest + (0 if plain else 2)
        cell_width = cap_width + label_width + BUTTON_GAP
        columns = max(1, min(len(self.keys[0]), (width - 1) // cell_width))
        if cell_width > width - 1:  # narrower than one button: cut the label
            label_width = max(width - 1 - cap_width - BUTTON_GAP, 0)
        rows = []
        for start in range(0, len(keys), columns):
            segments = [(" ", "")]
            for key, label in keys[start:start + columns]:
                cap = BUTTON_CAP
                if key in self.switches:
                    label += " on" if self.switches[key] else " off"
                    cap = BUTTON_CAP_ON if self.switches[key] else BUTTON_CAP
                elif key == "r" and self.mode == "offline":
                    cap = BUTTON_CAP_ALERT
                text = (label if plain else f" {label}")[:label_width].ljust(label_width)
                cell = [(f"[{key}] " if plain else f" {key} ", cap), (text, BUTTON_LABEL), (" " * BUTTON_GAP, "")]
                if segments_length(segments) + segments_length(cell) > width:
                    break  # not even the key cap fits
                segments += cell
            rows.append(styled(segments))
        return rows

    def banner(self, width: int) -> str:
        """The status bar, with the mode name letter-spaced on a wide badge when there is room."""
        label = BAR_LABEL[self.mode]
        text = f"   {' '.join(label)}   " if width >= 90 else f" {label} "
        return self.bar(width, (text, BAR_BADGE[self.mode]))

    def message_row(self, width: int) -> str:
        """The latest problem or the input prompt; empty when there is nothing to say."""
        return paint(f" {self.message}"[:max(width - 1, 0)], self.message_color) if self.message else ""

    def header_rows(self, width: int) -> list[str]:
        """Everything that stays fixed at the top, one string per terminal row."""
        banner = [self.banner(width) if colors_on() else self.bar(width)]
        rule = paint("─" * max(width - 1, 0), "dim")
        return [*banner, "", *self.key_rows(width), self.message_row(width), rule]


ESCAPE_KEYS = {"\033[A": "up", "\033[B": "down", "\033[C": "right", "\033[D": "left",
               "\033OA": "up", "\033OB": "down", "\033OC": "right", "\033OD": "left", "\033": "esc"}


class Screen:
    """The terminal: single key presses without Enter, and raw writes for drawing."""

    def __init__(self):
        self._typed: deque[str] = deque()
        self._terminal_settings = None

    def size(self) -> os.terminal_size:
        return shutil.get_terminal_size()

    def write(self, text: str):
        sys.stdout.write(text)
        sys.stdout.flush()

    def read_key(self, timeout: float) -> str | None:
        """Wait up to timeout seconds for a key press.

        Returns the character, or up, down, left, right or esc.
        """
        if not self._typed:
            ready, _, _ = select.select([sys.stdin], [], [], timeout)
            if not ready:
                return None
            chunk = os.read(sys.stdin.fileno(), 4096).decode("utf-8", "ignore")
            if chunk.startswith("\033"):
                return ESCAPE_KEYS.get(chunk)  # other escape sequences are ignored
            self._typed.extend(chunk)
        return self._typed.popleft() if self._typed else None

    def __enter__(self):
        import termios
        self._terminal_settings = termios.tcgetattr(sys.stdin.fileno())
        self.resume()
        return self

    def resume(self):
        """Take the terminal: single key presses, no echo (Ctrl+C still works), hidden cursor."""
        import tty
        tty.setcbreak(sys.stdin.fileno())
        self.write("\033[?25l")

    def suspend(self):
        """Hand the terminal to another program, such as an editor."""
        import termios
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self._terminal_settings)
        self.write("\033[r\033[?25h\033[2J\033[H")

    def __exit__(self, *exc):
        import termios
        if hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self._terminal_settings)
        # Reset the scroll region, show the cursor, clear the tab title
        self.write("\0337\033[r\0338\033[?25h\033]0;\007")
        return False


def rsync_flags(remote: str) -> str:
    """Base rsync flags. Compression only pays off over the network."""
    flags = "-a" if PRETTY else "-av"
    return flags + "z" if is_ssh_remote(remote) else flags


def parse_change(line: str) -> tuple[str, str]:
    """Classify one line of `rsync --out-format='%i %n%L'` output.

    Returns (kind, text) with kind one of new, updated, deleted, skip, message.
    """
    if not line.strip():
        return "skip", ""
    if line.startswith("*deleting"):
        return "deleted", line[len("*deleting"):].strip()
    if len(line) > 12 and line[0] in "<>ch." and line[1] in "fdLDS" and line[11] == " ":
        code, name = line[:11], line[12:]
        if code[0] == ".":
            return "skip", name  # attributes only, no content sent
        return ("new" if "+++++++++" in code else "updated"), name
    return "message", line


# rsync's complaints about source files that are gone. When deleting remote
# copies of locally deleted files, that is the expected state, not a problem.
VANISHED_MESSAGES = ("file has vanished:", "WARNING: parent dir is absent", "rsync warning: some files vanished")
VANISHED_EXIT_CODE = 24
# rsync exit codes that mean the connection failed, so a retry can help:
# socket I/O, protocol stream, timeouts, and ssh's own failure code
CONNECTION_EXIT_CODES = {10, 12, 30, 35, 255}

# No prompts, and notice a dead connection within about a minute instead of hanging
SSH_COMMAND = "ssh -T -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"

CHANGE_MARKS = {"new": ("+", "green"), "updated": ("~", "blue"), "deleted": ("-", "red")}


def run_rsync(cmd: list[str], quiet: bool = False) -> int:
    """Run rsync and turn its output into lines for the active project.

    With PRETTY that is one short line per change; otherwise rsync's own
    output. quiet hides rsync's messages and errors (changes are still shown).
    """
    global CHANGES
    dry_run = "--dry-run" in cmd
    if PRETTY:
        cmd = [cmd[0], "--out-format=%i %n%L", "--outbuf=L", *cmd[1:]]
    counts = {"new": 0, "updated": 0, "deleted": 0}
    seen_messages = set()
    deleting_missing = "--delete-missing-args" in cmd
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    for line in proc.stdout:
        line = line.rstrip("\n")
        if not PRETTY:
            if line.strip() and not quiet:
                emit(line, "dim")
            continue
        kind, text = parse_change(line)
        if kind in counts:
            counts[kind] += 1
            mark, color = CHANGE_MARKS[kind]
            emit(f"{mark} {text}", color, note="not synced" if dry_run else "")
        elif kind == "message" and not quiet and text not in seen_messages:
            if deleting_missing and text.startswith(VANISHED_MESSAGES):
                continue
            seen_messages.add(text)
            warn(text)
    rc = proc.wait()
    LAST_COUNTS.update(counts)
    if not dry_run:
        CHANGES += sum(counts.values())
    return rc


def sync_full(repo_root: Path, remote: str, exclude_file: Path, dry_run: bool,
              rsync: list[str] = RSYNC, quiet: bool = False) -> int:
    """Sync entire repo to remote."""
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        "--delete",
        f"--exclude-from={exclude_file}",
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    return run_rsync(cmd, quiet)


def resolve_in_project(text: str, repo_root: Path) -> str | None:
    """Turn a typed, pasted or dragged path into a path relative to the project root.

    Accepts absolute paths and paths relative to the current directory or the
    project root. Returns None if it does not exist or lies outside the project.
    """
    text = text.strip()
    try:
        parts = shlex.split(text)  # undo quotes and backslash-escaped spaces from drag and drop
    except ValueError:
        parts = []
    if len(parts) == 1:
        text = parts[0]
    if not text:
        return None
    path = Path(os.path.expanduser(text))
    candidates = [path] if path.is_absolute() else [Path.cwd() / path, repo_root / path]
    for candidate in candidates:
        if candidate.exists():
            try:
                return str(candidate.resolve().relative_to(repo_root.resolve()))
            except ValueError:
                continue
    return None


def sync_path(rel: str, repo_root: Path, remote: str, exclude_file: Path, dry_run: bool,
              rsync: list[str] = RSYNC) -> int:
    """Sync one file, or mirror one folder, keeping its relative path on the remote."""
    if rel == ".":
        return sync_full(repo_root, remote, exclude_file, dry_run, rsync)
    mirror = exclude_file if (repo_root / rel).is_dir() else None
    return sync_batch([rel], repo_root, remote, dry_run, rsync, mirror_excludes=mirror)


def inside_remote(rels: list[str]) -> list[str]:
    """Drop relative paths that could resolve outside the remote project directory."""
    safe = []
    for rel in rels:
        if not rel or rel.startswith("/") or ".." in Path(rel).parts or "\n" in rel or "\r" in rel:
            print(f"warning: skipping path outside the project: {rel!r}")
        else:
            safe.append(rel)
    return safe


def sync_batch(batch: list[str], repo_root: Path, remote: str, dry_run: bool = False,
               rsync: list[str] = RSYNC, delete_missing: bool = False, quiet: bool = False,
               mirror_excludes: Path | None = None) -> int:
    """Sync a batch of relative paths using rsync --files-from.

    --files-from implies --relative, so missing parent directories are created.
    With delete_missing, listed files that no longer exist locally are deleted
    on the remote. With mirror_excludes (an exclude file), listed folders are
    mirrored like a full sync: sent recursively, with remote extras deleted.
    """
    batch = inside_remote(batch)
    if not batch:
        return 0
    files_from = repo_root / ".xsync.files"
    files_from.write_text("\n".join(batch) + "\n")
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        *(["-r", "--delete", f"--exclude-from={mirror_excludes}"] if mirror_excludes else []),
        "--files-from", str(files_from),
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    if delete_missing:
        cmd.insert(1, "--delete-missing-args")
    try:
        rc = run_rsync(cmd, quiet)
    finally:
        files_from.unlink(missing_ok=True)
    return 0 if delete_missing and rc == VANISHED_EXIT_CODE else rc


INTERNAL_FILES = {".xsync.files", ".xsync.exclude"}


def is_ssh_remote(remote: str) -> bool:
    if remote.startswith("/") or remote.startswith("~/") or remote.startswith("./"):
        return False
    return ":" in remote


def ssh_reachable(remote: str, rsync: list[str] = RSYNC, quiet: bool = False) -> bool:
    """Check that the SSH host answers without prompting for a password.

    Probes through rsync instead of running a remote command, so it also
    works with keys that are restricted to rsync (rrsync).
    """
    host = remote.split(":", 1)[0]
    # -T: no terminal, even if ~/.ssh/config sets RequestTTY for this host
    ssh = "ssh -T -o BatchMode=yes -o ConnectTimeout=5"
    cmd = [rsync[0], "-e", ssh, "--list-only", f"{host}:."]
    errors = subprocess.DEVNULL if quiet else None
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=errors).returncode == 0


def normalize_remote(remote: str) -> str:
    """Expand ~ for local remotes and make sure the remote ends with a slash."""
    if not is_ssh_remote(remote):
        remote = os.path.expanduser(remote)
    return remote if remote.endswith("/") else remote + "/"


def unsafe_remote_reason(remote: str) -> str | None:
    """Return why remote is too dangerous for a --delete sync, or None if it is fine."""
    path = remote.split(":", 1)[1] if is_ssh_remote(remote) else os.path.expanduser(remote)
    stripped = path.rstrip("/")
    if not stripped:
        return "the remote path is empty or the filesystem root"
    # "." is the home directory over SSH and the current directory locally
    if os.path.normpath(stripped) in ("~", ".", str(Path.home())):
        return "the remote path is a home (or the current) directory"
    if ".." in Path(stripped).parts:
        return "the remote path contains '..'"
    return None


def missing_parent_dirs(rels: list[str], repo_root: Path) -> list[list[str]]:
    """Folders above the given paths that no longer exist locally, grouped deepest first."""
    by_depth: dict[int, set[str]] = {}
    for rel in rels:
        for parent in Path(rel).parents:
            if parent.parts and not (repo_root / parent).exists():
                by_depth.setdefault(len(parent.parts), set()).add(str(parent))
    return [sorted(by_depth[depth]) for depth in sorted(by_depth, reverse=True)]


def delete_from_remote(deleted_rels: list[str], repo_root: Path, remote: str,
                       rsync: list[str] = RSYNC, quiet: bool = False) -> int:
    """Delete specific files from remote without a full rsync scan.

    Folders that disappeared locally are removed too, but only once they are
    empty on the remote. Over SSH this goes through rsync (--delete-missing-args,
    GNU rsync 3.1+), so no shell command ever runs on the remote host.
    """
    rels = inside_remote(deleted_rels)
    folders = missing_parent_dirs(rels, repo_root)
    if is_ssh_remote(remote):
        rc = sync_batch(rels, repo_root, remote, rsync=rsync, delete_missing=True, quiet=quiet)
        if rc == 0:
            # One pass per depth: rsync only removes a folder that is already empty,
            # and stays silent here about folders that still hold remote-only files
            for level in folders:
                sync_batch(level, repo_root, remote, rsync=rsync, delete_missing=True, quiet=True)
        return rc
    # A local remote: delete directly, reporting each removal like rsync would
    global CHANGES
    base = Path(remote.rstrip("/"))
    removed = []
    for rel in rels:
        if (base / rel).is_file() or (base / rel).is_symlink():
            (base / rel).unlink()
            removed.append(rel)
    for level in folders:
        for folder in level:
            try:
                (base / folder).rmdir()
                removed.append(folder + "/")
            except OSError:
                pass  # not empty, or already gone
    for rel in removed:
        emit(f"- {rel}", "red")
    CHANGES += len(removed)
    return 0


def pattern_matches(pattern: str, parts: tuple[str, ...], is_dir: bool) -> bool:
    """Test one rsync-style exclude pattern against a path given as its components.

    Supports the common subset: a trailing / matches directories only, a leading /
    anchors at the project root, and a pattern containing / matches whole
    components at the end of the path.
    """
    if pattern.endswith("/") and not is_dir:
        return False
    anchored = pattern.startswith("/")
    pat = pattern.strip("/")
    if not pat:
        return False
    if anchored:
        return fnmatch.fnmatch("/".join(parts), pat)
    depth = pat.count("/") + 1
    return len(parts) >= depth and fnmatch.fnmatch("/".join(parts[-depth:]), pat)


def make_excluded_checker(repo_root: Path, patterns: list[str]):
    """Return a function that tests whether a resolved path should be excluded."""
    def is_excluded(abs_path: str) -> bool:
        try:
            rel = Path(abs_path).relative_to(repo_root)
        except ValueError:
            return True
        if rel.name in INTERNAL_FILES:
            return True
        parts = rel.parts
        for pattern in patterns:
            # The file itself, then every directory above it
            if pattern_matches(pattern, parts, is_dir=False):
                return True
            if any(pattern_matches(pattern, parts[:i], is_dir=True) for i in range(1, len(parts))):
                return True
        return False
    return is_excluded


RETRY_SECONDS = 10
# Seconds watch mode collects changes before sending them; `interval` in .xsync.toml overrides it
DEFAULT_INTERVAL = 2.0
HEARTBEAT_SECONDS = 60
IDLE = "in sync, watching for changes"
# Lines of history kept per project, so its list can be shown again after looking elsewhere
LOG_LINES = 2000

_RSYNC_VERSIONS: dict[str, str | None] = {}


def rsync_version(binary: str) -> str | None:
    """The output of `<binary> --version`, or None if it cannot be run. Asked once per binary."""
    if binary not in _RSYNC_VERSIONS:
        try:
            _RSYNC_VERSIONS[binary] = subprocess.run([binary, "--version"], capture_output=True, text=True).stdout
        except OSError:
            _RSYNC_VERSIONS[binary] = None
    return _RSYNC_VERSIONS[binary]


def clock() -> str:
    return f"{datetime.now():%H:%M:%S}"


class Project:
    """One project: its config, its watcher and queue, its state and its list of lines.

    While one of its operations runs it is the active output (see App.activate),
    so everything emit() and warn() produce lands in its own log.
    """

    def __init__(self, root: Path, app):
        self.root = root
        self.name = root.name
        self.app = app
        self.log: deque[str] = deque(maxlen=LOG_LINES)
        self.problems: deque[tuple[str, str]] = deque(maxlen=50)
        self.pending: set[str] = set()
        self.deleted: set[str] = set()
        self.lock = threading.Lock()
        self.observer = None
        self.offline = False
        self.changes = 0
        self.last_change = ""
        self.resting = ("idle, nothing checked yet", "busy")  # what the bar says when idle and not watching
        self.touched = False  # the user ran an action on it; only then is its host checked periodically
        self.last_flush = self.last_beat = time.monotonic()
        self.error = ""  # why this project cannot be synced, if it cannot
        self.config: dict = {}
        self.remote = ""
        self.exclude_patterns: list[str] = []
        self.rsync = RSYNC
        self.version = ""
        self.gnu = False
        self.interval = DEFAULT_INTERVAL
        self.is_excluded = lambda path: True
        self.panel = Panel(self.name, PROJECT_KEYS)
        self.load()

    def load(self):
        """Read .xsync.toml and work out how this project syncs; sets self.error if it cannot."""
        problem = self._load()
        self.error = problem or ""
        self.panel.remote = self.remote
        self.panel.transport = ("ssh" if is_ssh_remote(self.remote) else "local") if self.remote else ""
        self.panel.state, self.panel.level = (problem, "problem") if problem else self.resting
        self.panel.detail = self.detail()
        self.sync_switches()

    def reload(self):
        """Read the config again after it was edited. Watch mode is switched off first."""
        self.app.activate(self)
        was_watching = self.watching
        self.close()
        self.offline = False
        self.remote = ""
        self.load()
        emit("config reloaded" + ("; watch mode was switched off" if was_watching else ""), "dim")
        if self.error:
            warn(self.error, "magenta")
        self.rest()

    def _load(self) -> str | None:
        if not self.root.is_dir():
            return "folder not found"
        try:
            with open(self.root / ".xsync.toml", "rb") as f:
                config = tomllib.load(f)
        except FileNotFoundError:
            return "no .xsync.toml in this folder"
        except tomllib.TOMLDecodeError as error:
            return f"invalid .xsync.toml: {error}"
        self.config = config
        if not config.get("remote"):
            return "'remote' is not set in .xsync.toml"
        if config["remote"] == PLACEHOLDER_REMOTE:
            return "set 'remote' in .xsync.toml first (press e to edit)"
        self.remote = normalize_remote(config["remote"])
        # Full syncs run rsync --delete
        reason = unsafe_remote_reason(self.remote)
        if reason:
            return f"refusing to sync with --delete: {reason}"
        try:
            self.interval = float(config.get("interval", DEFAULT_INTERVAL))
        except (TypeError, ValueError):
            return "'interval' in .xsync.toml is not a number"
        self.exclude_patterns = list(config.get("exclude", []))
        self.is_excluded = make_excluded_checker(self.root, self.exclude_patterns)
        binary = resolve_rsync(config)
        version = rsync_version(binary)
        if version is None:
            return f"rsync not found: {binary}"
        self.version = version
        self.gnu = is_gnu_rsync3(version)
        extra_args = list(config.get("rsync_args", []))
        if is_ssh_remote(self.remote) and "RSYNC_RSH" not in os.environ:
            # Before the user's flags, so an -e in rsync_args still wins
            extra_args = ["-e", SSH_COMMAND, *extra_args]
        self.rsync = [binary, *extra_args]
        return None

    # --- output: this project's list and problem line

    def line(self, text: str):
        self.log.append(text)
        self.app.show_line(self, text)

    def problem(self, text: str):
        self.problems.append((clock(), text))
        self.panel.message = f"last problem {clock()}: {text}   [p] shows all"
        self.panel.message_color = "magenta"
        self.app.refresh(self)

    # --- state shown in the bar and in the overview

    @property
    def watching(self) -> bool:
        return self.observer is not None

    @property
    def verbose(self) -> bool:
        return not (self.app.pretty and self.gnu)

    def detail(self) -> str:
        return f"{self.changes} changes" + (f" · last {self.last_change}" if self.last_change else "")

    def sync_switches(self):
        self.panel.switches = {"w": self.watching, "v": self.verbose}

    def set_status(self, state: str, level: str = "ok", mode: str | None = None):
        """Say what this project is doing. level is ok, busy or problem."""
        self.panel.state, self.panel.level = state, level
        self.panel.detail = self.detail()
        if mode is not None:
            self.panel.mode = mode
        self.sync_switches()
        self.app.refresh(self)

    def rest(self):
        """Set the status to what this project is doing when nothing is running."""
        if self.error:
            self.set_status(self.error, "problem", "idle")
        elif self.offline:
            queued = len(self.pending) + len(self.deleted)
            self.set_status(f"offline, {queued} queued, retrying", "problem", "offline")
        elif self.watching:
            self.set_status(IDLE, "ok", "watch")
        else:
            self.set_status(*self.resting, "idle")

    def count_changes(self, before: int) -> int:
        """Add what rsync sent since `before` to this project's counter."""
        sent = CHANGES - before
        self.changes += sent
        if sent:
            self.last_change = clock()
        return sent

    def reached(self, codes: list[int]) -> bool:
        """Report rsync exit codes. False when the connection failed."""
        if any(code in CONNECTION_EXIT_CODES for code in codes):
            if not self.offline:
                self.offline = True
                warn(f"connection lost; retrying every {RETRY_SECONDS}s", "magenta")
            return False
        if self.offline:
            self.offline = False
            emit("reconnected", "green")
        for code in codes:
            if code != 0:
                warn(f"rsync exited with code {code}", "magenta")
        return True

    @contextlib.contextmanager
    def excludes(self):
        """The exclude list as a file for rsync, removed again afterwards."""
        path = write_exclude_file(self.root, self.exclude_patterns)
        try:
            yield path
        finally:
            path.unlink(missing_ok=True)

    # --- actions

    def full_sync(self):
        self.app.activate(self)
        self.set_status("syncing…", "busy")
        before = CHANGES
        with self.excludes() as exclude_file:
            rc = sync_full(self.root, self.remote, exclude_file, False, self.rsync, quiet=self.offline)
        if self.reached([rc]):
            if not self.count_changes(before) and rc == 0 and PRETTY:
                emit("already up to date", "dim")
            when = clock()[:5]
            self.resting = (f"in sync at {when}", "ok") if rc == 0 else (f"sync had errors at {when}", "problem")
        self.rest()

    def compare(self):
        self.app.activate(self)
        self.set_status("comparing…", "busy")
        with self.excludes() as exclude_file:
            rc = sync_full(self.root, self.remote, exclude_file, True, self.rsync, quiet=self.offline)
        if self.reached([rc]):
            differences = sum(LAST_COUNTS.values())
            when = clock()[:5]
            if not PRETTY:
                self.resting = (f"compared at {when}", "busy")  # raw output: the count is not known
            elif differences:
                emit(f"{differences} difference(s), nothing changed; press s to sync", "dim")
                self.resting = (f"{differences} differences at {when}", "busy")
            elif rc == 0:
                emit("no differences", "dim")
                self.resting = (f"in sync at {when}", "ok")
        self.rest()

    def sync_one(self, text: str):
        """Sync the file or folder the user typed, pasted or dragged in."""
        self.app.activate(self)
        rel = resolve_in_project(text, self.root)
        if rel is None:
            warn(f"not found inside the project: {text.strip()}", "magenta")
            return
        self.set_status(f"syncing {rel}…", "busy")
        before = CHANGES
        with self.excludes() as exclude_file:
            rc = sync_path(rel, self.root, self.remote, exclude_file, False, self.rsync)
        if self.reached([rc]) and not self.count_changes(before) and rc == 0 and PRETTY:
            emit(f"{rel}: already up to date", "dim")
        self.rest()

    def start_watch(self):
        self.app.activate(self)
        try:
            from watchdog.observers import Observer
            from watchdog.events import FileSystemEventHandler
        except ImportError:
            warn("watch mode needs watchdog, which is not installed (pip install watchdog)", "magenta")
            return
        project = self

        class Handler(FileSystemEventHandler):
            def _handle(self, abs_path: str):
                if project.is_excluded(abs_path):
                    return
                try:
                    rel = str(Path(abs_path).relative_to(project.root))
                except ValueError:
                    return
                with project.lock:
                    project.pending.add(rel)

            def on_modified(self, event):
                if not event.is_directory:
                    self._handle(event.src_path)

            def on_created(self, event):
                if not event.is_directory:
                    self._handle(event.src_path)

            def on_moved(self, event):
                if not event.is_directory:
                    # src is gone on remote; dest needs to be pushed
                    self._handle(event.dest_path)
                    # Excluded paths are never ours to delete on the remote
                    if project.is_excluded(event.src_path):
                        return
                    try:
                        rel = str(Path(event.src_path).relative_to(project.root))
                        with project.lock:
                            project.deleted.add(rel)
                    except ValueError:
                        pass

            def on_deleted(self, event):
                if event.is_directory:
                    return
                if project.is_excluded(event.src_path):
                    return
                try:
                    rel = str(Path(event.src_path).relative_to(project.root))
                except ValueError:
                    return
                with project.lock:
                    project.pending.discard(rel)
                    project.deleted.add(rel)

        # Start listening before the full sync, so nothing changed meanwhile is missed
        self.observer = Observer()
        self.observer.schedule(Handler(), str(self.root), recursive=True)
        self.observer.start()
        self.last_flush = time.monotonic()
        self.full_sync()

    def stop_watch(self):
        self.app.activate(self)
        self.close()
        emit("watch off", "dim")
        self.rest()

    def close(self):
        """Stop watching and forget what was queued."""
        if self.observer is not None:
            self.observer.stop()
            self.observer.join()
            self.observer = None
        with self.lock:
            self.pending.clear()
            self.deleted.clear()

    def flush(self):
        """Send what the watcher collected since the last flush."""
        with self.lock:
            batch = list(self.pending)
            self.pending.clear()
            removals = list(self.deleted)
            self.deleted.clear()

        # Anything "deleted" that still exists was overwritten (atomic write) — sync it
        overwritten = [f for f in removals if (self.root / f).exists()]
        removals = [f for f in removals if not (self.root / f).exists()]
        batch = list(set(batch) | set(overwritten))

        # Drop batch entries that no longer exist (temp files from atomic writes)
        batch = [f for f in batch if (self.root / f).exists()]

        if not batch and not removals:
            return
        self.app.activate(self)
        if not self.offline:
            self.set_status("syncing…", "busy")
        before = CHANGES
        codes = []
        if removals:
            codes.append(delete_from_remote(removals, self.root, self.remote, self.rsync, quiet=self.offline))
        if batch:
            codes.append(sync_batch(batch, self.root, self.remote, rsync=self.rsync, quiet=self.offline))
        if self.reached(codes):
            self.count_changes(before)
        else:
            # Keep the changes and try again until the connection is back
            with self.lock:
                self.pending.update(batch)
                self.deleted.update(removals)
        self.rest()

    def check_connection(self, announce: bool):
        """Probe the host; go offline or come back online accordingly."""
        self.app.activate(self)
        if not is_ssh_remote(self.remote):
            if announce:
                emit("local remote, no connection to check", "dim")
            return
        if announce:
            self.set_status("connecting…", "busy")
        was_offline = self.offline
        if ssh_reachable(self.remote, self.rsync, quiet=True):
            self.reached([0])
            if announce and not was_offline:
                emit("connection ok", "dim")
            if was_offline and self.watching:
                self.flush()
        else:
            self.reached([255])
        self.rest()

    def show_problems(self):
        self.app.activate(self)
        if not self.problems:
            emit("no problems recorded", "dim")
        for when, text in self.problems:
            emit(f"! {when}  {text}", "yellow")
        self.problems.clear()
        self.panel.message = ""
        self.app.refresh(self)

    def show_status(self):
        """List the resolved setup."""
        self.app.activate(self)
        self.set_status("checking…", "busy")
        rows, _ = status_rows(self.root, self.config, self.remote, self.rsync, self.version)
        for label, value in rows:
            emit(f"{label.ljust(11)} {value}", "dim")
        self.rest()

    def show_help(self):
        self.app.activate(self)
        emit(f"xsync {__version__}", "bold")
        for keys in PROJECT_KEYS:
            for key, _ in keys:
                emit(f"{key}   {KEY_HELP[key]}", "dim")

    def tick(self, now: float):
        """Called a few times a second: send queued changes and check the host when due."""
        if self.error:
            return
        if self.watching and now - self.last_flush >= (RETRY_SECONDS if self.offline else self.interval):
            self.last_flush = now
            self.flush()
        # Notice a dropped connection without waiting for the next change
        in_use = self.touched or self.watching
        if in_use and now - self.last_beat >= (RETRY_SECONDS if self.offline else HEARTBEAT_SECONDS):
            self.last_beat = now
            self.check_connection(announce=False)


def registry_path() -> Path:
    """The file that remembers which projects exist, in the user's config folder."""
    base = os.environ.get("XDG_CONFIG_HOME") or "~/.config"
    return Path(os.path.expanduser(base)) / "xsync" / "projects.toml"


def load_registry(path: Path) -> list[Path]:
    try:
        with open(path, "rb") as f:
            entries = tomllib.load(f).get("projects", [])
    except (FileNotFoundError, tomllib.TOMLDecodeError):
        return []
    return [Path(entry) for entry in entries if isinstance(entry, str)]


def save_registry(path: Path, roots: list[Path]):
    path.parent.mkdir(parents=True, exist_ok=True)
    lines = ["# Projects xsync knows about. Managed by xsync: a project is added when you run", 
             "# xsync inside it, or with the a key in the overview; the x key removes one.",
             "projects = ["]
    lines += [f"    {json.dumps(str(root))}," for root in roots]
    path.write_text("\n".join(lines + ["]"]) + "\n")


def clean_path(text: str) -> str:
    """Undo the quotes and backslash-escaped spaces of a pasted or dragged path."""
    text = text.strip()
    try:
        parts = shlex.split(text)
    except ValueError:
        parts = []
    return os.path.expanduser(parts[0] if len(parts) == 1 else text)


class App:
    """The hub: an overview of all remembered projects, and one project's view at a time.

    Everything runs in one loop: keys are handled, then every project gets a
    tick. Projects with watch mode on therefore keep syncing whichever view is
    shown, and one long sync briefly holds up the rest.
    """

    def __init__(self, registry: Path, verbose: bool = False, screen: Screen | None = None):
        self.registry = registry
        self.screen = screen or Screen()
        self.pretty = not verbose
        self.view: Project | None = None  # None shows the overview
        self.selected = 0
        self.panel = Panel("", OVERVIEW_KEYS)
        self.notes: list[str] = []  # lines under the overview table, until the next key press
        self._drawn_rows = 0
        self.projects = [Project(root, self) for root in load_registry(registry)]

    # --- projects

    def register(self, root: Path) -> Project:
        """Remember a project (if it is new) and return it."""
        root = root.resolve()
        for project in self.projects:
            if project.root == root:
                return project
        project = Project(root, self)
        self.projects.append(project)
        self.save()
        return project

    def remove(self, project: Project):
        """Forget a project. Its files, local and remote, are not touched."""
        project.close()
        self.projects.remove(project)
        self.selected = max(0, min(self.selected, len(self.projects) - 1))
        self.save()

    def save(self):
        save_registry(self.registry, [project.root for project in self.projects])

    def activate(self, project: Project):
        """Make a project the one whose rsync output and warnings are being recorded."""
        global OUTPUT, PRETTY
        OUTPUT = project
        PRETTY = self.pretty and project.gnu

    # --- drawing

    def show_line(self, project: Project, text: str):
        """A project added a line to its list; print it if that list is on screen."""
        if self.view is project:
            print(text, flush=True)

    def refresh(self, project: Project | None = None):
        """Redraw the fixed rows if what changed is visible."""
        if self.view is None or project is None or project is self.view:
            self.draw()

    def draw(self, clear: bool = False):
        if self.view is None:
            self.draw_overview()
        else:
            self.draw_project(clear)

    def summarize(self):
        """Fill the overview's status bar from the state of all projects."""
        watching = sum(project.watching for project in self.projects)
        offline = sum(project.offline for project in self.projects)
        broken = sum(bool(project.error) for project in self.projects)
        count = len(self.projects)
        self.panel.name = f"{count} project" + ("" if count == 1 else "s")
        parts = [f"{watching} watching"] if watching else []
        parts += [f"{offline} offline"] if offline else []
        parts += [f"{broken} with a problem"] if broken else []
        self.panel.state = ", ".join(parts) or "nothing watching"
        self.panel.level = "problem" if offline or broken else ("ok" if watching else "busy")
        self.panel.mode = "offline" if offline else "idle"
        changes = sum(project.changes for project in self.projects)
        self.panel.detail = f"{changes} changes" if changes else ""
        self.panel.switches = {"v": not self.pretty}

    def table_rows(self, width: int) -> list[str]:
        """The overview: one row per project, the highlighted one marked."""
        if not self.projects:
            return [paint("  No projects yet. Press a to add this folder or another one.", "dim")]
        name_width = min(max(len(project.name) for project in self.projects), 28)
        rows = []
        for index, project in enumerate(self.projects):
            selected = index == self.selected
            left = [(" › " if selected else "   ", "1;97"), (project.name[:name_width].ljust(name_width), "1;97")]
            if project.remote:
                left += [("   ", ""), (f" {project.panel.transport.upper()} ", BAR_TRANSPORT),
                         (f" {project.remote}", "38;5;250")]
            right = [("●", BAR_DOT[project.panel.level]), (f" {project.panel.state}", "38;5;255")]
            if project.changes:
                right += [("   ", ""), (f" {project.changes} changes ", BAR_TAG)]
            right.append((" ", ""))
            if project.remote:  # too narrow: shorten the remote
                room = width - segments_length(left[:4]) - 2 - segments_length(right)
                if len(left[4][0]) > room:
                    left[4] = (left[4][0][:max(room - 1, 0)] + "…" if room > 0 else "", left[4][1])
            rows.append(styled(spread(left, right, width), ROW_SELECTED if selected else ""))
        return rows

    def draw_overview(self):
        size = self.screen.size()
        width = size.columns
        self._drawn_rows = 0  # the next project view starts from a cleared screen
        self.summarize()
        notes = [paint(f" {note}"[:max(width - 1, 0)], "dim") for note in self.notes]
        rows = (self.panel.header_rows(width) + self.table_rows(width) + [""] + notes)[:size.lines]
        fixed = "".join(f"\033[{row};1H\033[2K{text}" for row, text in enumerate(rows, 1))
        below = f"\033[{len(rows) + 1};1H\033[J" if len(rows) < size.lines else ""
        title = f"\033]0;xsync: {self.panel.state}\007"
        self.screen.write(f"\033[r{fixed}{below}{title}")

    def draw_project(self, clear: bool = False):
        """The fixed rows of the project on screen; its list scrolls in the region below them."""
        project = self.view
        size = self.screen.size()
        rows = project.panel.header_rows(size.columns)
        # The header grows when the buttons wrap; start over rather than draw over the list
        clear = clear or len(rows) != self._drawn_rows
        self._drawn_rows = len(rows)
        top = len(rows) + 1
        # Setting the scroll region moves the cursor, so save and restore it
        start = "\033[2J" if clear else "\0337"
        end = f"\033[{top};1H" if clear else "\0338"
        fixed = "".join(f"\033[{row};1H\033[2K{text}" for row, text in enumerate(rows, 1))
        title = f"\033]0;xsync {project.name}: {project.panel.state}\007"
        out = f"{start}\033[{top};{size.lines}r{fixed}{end}{title}"
        if clear:  # show the end of this project's list again
            tail = list(project.log)[-max(size.lines - top, 0):] if size.lines > top else []
            out += "".join(line + "\n" for line in tail)
        self.screen.write(out)

    # --- input

    def ask(self, label: str, text: str = "") -> str | None:
        """Read a line of text on the message row, starting from `text`. Returns None if cancelled with Esc."""
        panel = self.view.panel if self.view else self.panel
        previous = (panel.message, panel.message_color)
        while True:
            panel.message, panel.message_color = f"{label}: {text}▏   Enter to confirm, Esc to cancel", "bold"
            self.draw()
            key = self.screen.read_key(0.5)
            if key is None:
                continue
            if key in ("\r", "\n"):
                break
            if key == "esc":
                text = None
                break
            if key in ("\x7f", "\b"):
                text = text[:-1]
            elif key == "\x15":  # Ctrl+U
                text = ""
            elif len(key) == 1 and key.isprintable():
                text += key
        panel.message, panel.message_color = previous
        self.draw()
        return text

    def open(self, project: Project):
        self.view = project
        self.selected = self.projects.index(project)
        self.notes = []
        self.draw(clear=True)

    def back(self):
        self.view = None
        self.draw()

    def toggle_verbose(self) -> str:
        """Switch between the summarized list and rsync's raw output, for all projects."""
        self.pretty = not self.pretty
        for project in self.projects:
            project.sync_switches()
        return "verbose off" if self.pretty else "verbose on: showing rsync's raw output"

    def add_project(self):
        """Add a folder as a project; a folder without a config gets a starter one to edit."""
        text = self.ask("project folder to add (type, paste or drag; Ctrl+U clears)", str(Path.cwd()))
        if not text:
            return
        folder = Path(clean_path(text))
        if not folder.is_dir():
            self.notes = [f"Not a folder: {folder}"]
            return
        root = find_root(folder.resolve())
        created = root is None
        if created:
            root = folder.resolve()
            (root / ".xsync.toml").write_text(STARTER_CONFIG)
        project = self.register(root)
        self.selected = self.projects.index(project)
        if created:
            self.edit_config(project)
            self.notes.insert(0, f"Created {root / '.xsync.toml'}.")
        else:
            self.notes = [f"Added {project.name}."]

    def edit_config(self, project: Project):
        """Open the project's .xsync.toml in the user's editor, then read it again."""
        editor = shlex.split(os.environ.get("VISUAL") or os.environ.get("EDITOR") or "nano")
        self.screen.suspend()
        try:
            subprocess.run([*editor, str(project.root / ".xsync.toml")])
            failed = ""
        except OSError as error:
            failed = f"Could not start the editor '{editor[0]}': {error}. Set $EDITOR to the one you use."
        finally:
            self.screen.resume()
            self._drawn_rows = 0  # the editor used the whole screen; start over
        project.reload()
        self.notes = [failed or f"{project.name}: {project.error or 'config reloaded'}"]
        self.draw(clear=True)

    def on_overview_key(self, key: str):
        self.notes = []
        project = self.projects[self.selected] if self.projects else None
        if key in ("up", "k"):
            self.selected = max(self.selected - 1, 0)
        elif key in ("down", "j"):
            self.selected = min(self.selected + 1, max(len(self.projects) - 1, 0))
        elif key == "a":
            self.add_project()
        elif key == "v":
            self.notes = [self.toggle_verbose()]
        elif key == "h":
            self.notes = [f"xsync {__version__}"] + [f"{keys.ljust(5)} {text}" for keys, text in OVERVIEW_HELP.items()]
        elif project is None:
            pass
        elif key == "x":
            self.remove(project)
            self.notes = [f"Forgot {project.name}: it is off this list, and no file was touched. Add it back with a."]
        elif key == "e":
            self.edit_config(project)
            return
        elif key in ("o", "\r", "\n", "right"):
            self.open(project)
            return
        elif key in ("s", "c", "w"):
            if project.error:
                self.notes = [f"{project.name}: {project.error}"]
            else:
                project.touched = True
                if key == "s":
                    project.full_sync()
                elif key == "c":
                    project.compare()
                elif project.watching:
                    project.stop_watch()
                else:
                    project.start_watch()
                self.notes = [f"{project.name}: {project.panel.state}. Press o to see its list."]
        self.draw()

    def on_project_key(self, key: str):
        project = self.view
        if key in ("b", "esc", "left"):
            self.back()
            return
        self.activate(project)
        actions = {"s": project.full_sync, "c": project.compare, "i": project.show_status,
                   "r": lambda: project.check_connection(announce=True),
                   "w": lambda: project.stop_watch() if project.watching else project.start_watch()}
        if key == "h":
            project.show_help()
        elif key == "p":
            project.show_problems()
        elif key == "e":
            self.edit_config(project)
        elif key == "l":
            project.log.clear()
            self.draw(clear=True)
        elif key == "v":
            message = self.toggle_verbose()
            if self.pretty and not project.gnu:
                message = "the summarized output needs GNU rsync 3.x; this project stays verbose"
            emit(message, "dim")
            project.rest()
        elif key in actions or key == "f":
            if project.error:
                warn(project.error, "magenta")
            else:
                project.touched = True
                if key == "f":
                    text = self.ask("file or folder to sync (type, paste or drag it here)")
                    if text:
                        project.sync_one(text)
                else:
                    actions[key]()

    def run(self):
        """Show the overview and handle keys until quit."""
        global OUTPUT
        try:
            with self.screen:
                if hasattr(signal, "SIGWINCH"):
                    signal.signal(signal.SIGWINCH, lambda *_: self.draw(clear=True))
                # Nothing runs until a key is pressed: no compare, no sync, no connection
                self.draw()
                while True:
                    key = self.screen.read_key(0.2)
                    if key == "q":
                        break
                    if key is not None:
                        if self.view is None:
                            self.on_overview_key(key)
                        else:
                            self.on_project_key(key)
                    now = time.monotonic()
                    for project in list(self.projects):
                        project.tick(now)
        except KeyboardInterrupt:
            pass
        finally:
            OUTPUT = Printer()
            for project in self.projects:
                project.close()


def status_rows(repo_root: Path, config: dict, remote: str, rsync: list[str], version: str) -> tuple[list, bool]:
    """The resolved setup as (label, value) rows, and whether a sync could run."""
    ssh = is_ssh_remote(remote)
    found = re.search(r"version\s+(\S+)", version)
    flavor = f"GNU rsync {found.group(1)}" if is_gnu_rsync3(version) and found else "not GNU rsync 3.x"
    try:
        import watchdog  # noqa: F401
        watching = "available"
    except ImportError:
        watching = "watchdog is not installed (pip install watchdog)"
    reason = unsafe_remote_reason(remote)
    if not ssh:
        reachable = "folder exists" if Path(remote).is_dir() else "folder not found"
    else:
        reachable = "reachable" if ssh_reachable(remote, rsync, quiet=True) else "not reachable"
    rows = [
        ("version", f"xsync {__version__}"),
        ("project", str(repo_root)),
        ("config", str(repo_root / ".xsync.toml")),
        ("remote", f"{remote}  ({'ssh' if ssh else 'local path'})"),
        ("host" if ssh else "target", reachable),
        ("full sync", "allowed" if reason is None else f"refused: {reason}"),
        ("rsync", f"{rsync[0]}  ({flavor})"),
        ("rsync_args", " ".join(config.get("rsync_args", [])) or "none"),
        ("exclude", f"{len(config.get('exclude', []))} patterns"),
        ("interval", f"{float(config.get('interval', DEFAULT_INTERVAL)):g}s between watch batches"),
        ("watch mode", watching),
    ]
    return rows, reason is None and reachable in ("reachable", "folder exists")


def cmd_init():
    """Scaffold a starter .xsync.toml in the current directory."""
    target = Path.cwd() / ".xsync.toml"
    if target.exists():
        print(f"Already exists: {target}")
        sys.exit(1)
    target.write_text(STARTER_CONFIG)
    print(f"Created {target}")
    print("Edit the 'remote' line in it to point to your destination.")


KNOWN_FLAGS = {"--init", "--verbose", "--version", "--help", "-h"}


def main():
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return

    if "--version" in args:
        print(f"xsync {__version__}")
        return

    # Syncing only ever happens on a key press inside the session
    unknown = [a for a in args if a not in KNOWN_FLAGS]
    if unknown:
        print(f"error: unknown argument: {' '.join(unknown)}")
        print("   Run `xsync` and use the keys, or `xsync --help`.")
        sys.exit(2)

    if "--init" in args:
        cmd_init()
        return

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("error: xsync needs a terminal. Run `xsync` in a terminal and use the keys.")
        sys.exit(1)

    app = App(registry_path(), verbose="--verbose" in args)
    # Always the overview. Run inside a project, that project is remembered and highlighted.
    here = find_root(Path.cwd())
    if here is not None:
        app.selected = app.projects.index(app.register(here))
    app.run()

if __name__ == "__main__":
    main()
