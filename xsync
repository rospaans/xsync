BUTTON_CAP, BUTTON_CAP_ON, BUTTON_CAP_ALERT = "1;38;5;16;48;5;252", "1;38;5;16;48;5;78", "1;38;5;16;48;5;176"
BUTTON_LABEL = "38;5;255;48;5;238"
BUTTON_GAP = 2


def styled(segments: list[tuple[str, str]], background: str = "") -> str:
    """Join (text, color code) pairs into one string; plain text when colors are off."""
    if not colors_on():
        return "".join(text for text, _ in segments)
    out = ""
    for text, code in segments:
        codes = ";".join(part for part in ("0", background, code) if part)
        out += f"\033[{codes}m{text}"
    return out + "\033[0m"


def segments_length(segments: list[tuple[str, str]]) -> int:
    return sum(len(text) for text, _ in segments)


def clip_segments(segments: list[tuple[str, str]], width: int) -> list[tuple[str, str]]:
    """Cut segments off at width characters, as a last resort on a tiny terminal."""
    clipped = []
    for text, code in segments:
        room = width - segments_length(clipped)
        if room <= 0:
            break
        clipped.append((text[:room], code))
    return clipped


class Screen:
    """The session display.

    A status banner, a grid of buttons and a message line stay fixed at the top
    of the terminal (using a scroll region) while changes scroll below, and
    single key presses are read without Enter.
    """

    def __init__(self, name: str, remote: str, transport: str):
        self.name, self.remote, self.transport = name, remote, transport
        self.mode, self.state, self.level, self.detail = "idle", "starting…", "busy", ""
        self.watching = False
        self.verbose = False
        self.message, self.message_color = "", "dim"
        self._typed: deque[str] = deque()
        self._drawn_rows = 0
        self._terminal_settings = None

    # --- the fixed rows

    def bar(self, width: int) -> str:
        """What is synced on the left, the current state on the right."""
        left = [(f" {BAR_LABEL[self.mode]} ", BAR_BADGE[self.mode]), (f"  {self.name}", "1;97"), ("  →  ", "38;5;250"),
                (f" {self.transport.upper()} ", BAR_TRANSPORT), (f" {self.remote}", "38;5;250")]
        right = [("●", BAR_DOT[self.level]), (f" {self.state}", "38;5;255")]
        # detail is "N changes · last HH:MM:SS": the count as a tag, the time after it
        count, _, last = self.detail.partition(" · ")
        extras = []
        if count:
            extras += [("   ", ""), (f" {count} ", BAR_TAG)]
        if last:
            extras.append((f"  {last}", "38;5;250"))
        right += extras + [(" ", "")]

        # Too narrow: drop the time, then the count, then shorten the remote, then the state
        while extras and segments_length(left) + 2 + segments_length(right) > width:
            extras.pop()
            if extras and extras[-1][0] == "   ":
                extras.pop()
            right = right[:2] + extras + [(" ", "")]
        room = width - segments_length(left[:4]) - 2 - segments_length(right)
        if len(left[4][0]) > room:
            left[4] = (left[4][0][:max(room - 1, 0)] + "…" if room > 0 else "", left[4][1])
        over = segments_length(left) + segments_length(right) - width
        if over > 0:
            right[1] = (right[1][0][:max(len(right[1][0]) - over, 0)], right[1][1])
        while len(left) > 1 and segments_length(left) + segments_length(right) > width:
            left.pop()
        gap = max(width - segments_length(left) - segments_length(right), 0)
        return styled(clip_segments(left + [(" " * gap, "")] + right, width), BAR_BACKGROUND)

    def key_rows(self, width: int) -> list[str]:
        """The keys as a grid of equal-width buttons.

        As many columns as fit with full labels; a narrower terminal gets fewer
        columns and more rows, down to one button per line.
        """
        plain = not colors_on()
        switched_on = {"w": self.watching, "v": self.verbose}
        keys = [item for row in SESSION_KEYS for item in row]
        cap_width = 4 if plain else 3   # "[s] " or " s "
        longest = max(len(label) + (len(" off") if key in switched_on else 0) for key, label in keys)
        label_width = longest + (0 if plain else 2)
        cell_width = cap_width + label_width + BUTTON_GAP
        columns = max(1, min(len(SESSION_KEYS[0]), (width - 1) // cell_width))
        if cell_width > width - 1:  # narrower than one button: cut the label
            label_width = max(width - 1 - cap_width - BUTTON_GAP, 0)
        rows = []
        for start in range(0, len(keys), columns):
            segments = [(" ", "")]
            for key, label in keys[start:start + columns]:
                cap = BUTTON_CAP
                if key in switched_on:
                    label += " on" if switched_on[key] else " off"
                    cap = BUTTON_CAP_ON if switched_on[key] else BUTTON_CAP
                elif key == "r" and self.mode == "offline":
                    cap = BUTTON_CAP_ALERT
                text = (label if plain else f" {label}")[:label_width].ljust(label_width)
                cell = [(f"[{key}] " if plain else f" {key} ", cap), (text, BUTTON_LABEL), (" " * BUTTON_GAP, "")]
                if segments_length(segments) + segments_length(cell) > width:
                    break  # not even the key cap fits
                segments += cell
            rows.append(styled(segments))
        return rows

    def header_rows(self, width: int) -> list[str]:
        """Everything that stays fixed at the top, one string per terminal row."""
        if colors_on():
            # A three-row banner: the bar with a row of its background above and below
            padding = styled([(" " * width, "")], BAR_BACKGROUND)
            banner = [padding, self.bar(width), padding]
        else:
            banner = [self.bar(width)]
        rule = paint("─" * max(width - 1, 0), "dim")
        return [*banner, "", *self.key_rows(width), self.message_row(width), rule]

    def message_row(self, width: int) -> str:
        """The latest problem or the input prompt; empty when there is nothing to say."""
        return paint(f" {self.message}"[:max(width - 1, 0)], self.message_color) if self.message else ""

    def draw(self, clear: bool = False):
        size = shutil.get_terminal_size()
        rows = self.header_rows(size.columns)
        # The header grows when the buttons wrap; start over rather than draw over the list
        clear = clear or len(rows) != self._drawn_rows
        self._drawn_rows = len(rows)
        top = len(rows) + 1
        # Setting the scroll region moves the cursor, so save and restore it
        start = "\033[2J" if clear else "\0337"
        end = f"\033[{top};1H" if clear else "\0338"
        fixed = "".join(f"\033[{row};1H\033[2K{text}" for row, text in enumerate(rows, 1))
        title = f"\033]0;xsync {self.name}: {self.state}\007"
        sys.stdout.write(f"{start}\033[{top};{size.lines}r{fixed}{end}{title}")
        sys.stdout.flush()

    def set_status(self, state: str, level: str = "ok", detail: str | None = None, mode: str | None = None):
        """Say what the session is doing. level is ok, busy or problem."""
        self.state, self.level = state, level
        if detail is not None:
            self.detail = detail
        if mode is not None:
            self.mode = mode
        self.draw()

    def set_message(self, text: str, color: str = "magenta"):
        self.message, self.message_color = text, color
        self.draw()

    # --- keys

    def read_key(self, timeout: float) -> str | None:
        """Wait up to timeout seconds for a key press."""
        if not self._typed:
            ready, _, _ = select.select([sys.stdin], [], [], timeout)
            if not ready:
                return None
            chunk = os.read(sys.stdin.fileno(), 4096).decode("utf-8", "ignore")
            if chunk.startswith("\033") and len(chunk) > 1:
                return None  # arrow keys and other escape sequences
            self._typed.extend(chunk)
        return self._typed.popleft() if self._typed else None

    def ask(self, label: str) -> str | None:
        """Read a line of text on the message row. Returns None if cancelled with Esc."""
        previous = (self.message, self.message_color)
        text = ""
        while True:
            self.set_message(f"{label}: {text}▏   Enter to confirm, Esc to cancel", "bold")
            key = self.read_key(0.5)
            if key is None:
                continue
            if key in "\r\n":
                break
            if key == "\033":
                text = None
                break
            if key in ("\x7f", "\b"):
                text = text[:-1]
            elif key == "\x15":  # Ctrl+U
                text = ""
            elif key.isprintable():
                text += key
        self.set_message(*previous)
        return text

    # --- setup and teardown

    def __enter__(self):
        import termios
        import tty
        self._terminal_settings = termios.tcgetattr(sys.stdin.fileno())
        tty.setcbreak(sys.stdin.fileno())  # single key presses, no echo; Ctrl+C still works
        self.draw(clear=True)
        if hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, lambda *_: self.draw())
        return self

    def __exit__(self, *exc):
        import termios
        if hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, signal.SIG_DFL)
        termios.tcsetattr(sys.stdin.fileno(), termios.TCSADRAIN, self._terminal_settings)
        sys.stdout.write("\0337\033[r\0338\033]0;\007")
        sys.stdout.flush()
        return False


def rsync_flags(remote: str) -> str:
    """Base rsync flags. Compression only pays off over the network."""
    flags = "-a" if PRETTY else "-av"
    return flags + "z" if is_ssh_remote(remote) else flags


def parse_change(line: str) -> tuple[str, str]:
    """Classify one line of `rsync --out-format='%i %n%L'` output.

    Returns (kind, text) with kind one of new, updated, deleted, skip, message.
    """
    if not line.strip():
        return "skip", ""
    if line.startswith("*deleting"):
        return "deleted", line[len("*deleting"):].strip()
    if len(line) > 12 and line[0] in "<>ch." and line[1] in "fdLDS" and line[11] == " ":
        code, name = line[:11], line[12:]
        if code[0] == ".":
            return "skip", name  # attributes only, no content sent
        return ("new" if "+++++++++" in code else "updated"), name
    return "message", line


# rsync's complaints about source files that are gone. When deleting remote
# copies of locally deleted files, that is the expected state, not a problem.
VANISHED_MESSAGES = ("file has vanished:", "WARNING: parent dir is absent", "rsync warning: some files vanished")
VANISHED_EXIT_CODE = 24
# rsync exit codes that mean the connection failed, so a retry can help:
# socket I/O, protocol stream, timeouts, and ssh's own failure code
CONNECTION_EXIT_CODES = {10, 12, 30, 35, 255}

# No prompts, and notice a dead connection within about a minute instead of hanging
SSH_COMMAND = "ssh -T -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"

CHANGE_MARKS = {"new": ("+", "green"), "updated": ("~", "blue"), "deleted": ("-", "red")}


def run_rsync(cmd: list[str], quiet: bool = False) -> int:
    """Run rsync. With PRETTY, print one short line per change instead of rsync's output.

    quiet hides rsync's messages and errors (changes are still shown).
    """
    global CHANGES
    if not PRETTY:
        silence = subprocess.DEVNULL if quiet else None
        return subprocess.run(cmd, stdout=silence, stderr=silence).returncode
    dry_run = "--dry-run" in cmd
    cmd = [cmd[0], "--out-format=%i %n%L", "--outbuf=L", *cmd[1:]]
    counts = {"new": 0, "updated": 0, "deleted": 0}
    seen_messages = set()
    deleting_missing = "--delete-missing-args" in cmd
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    for line in proc.stdout:
        kind, text = parse_change(line.rstrip("\n"))
        if kind in counts:
            counts[kind] += 1
            mark, color = CHANGE_MARKS[kind]
            emit(f"{mark} {text}", color, note="not synced" if dry_run else "")
        elif kind == "message" and not quiet and text not in seen_messages:
            if deleting_missing and text.startswith(VANISHED_MESSAGES):
                continue
            seen_messages.add(text)
            warn(text)
    rc = proc.wait()
    LAST_COUNTS.update(counts)
    if not dry_run:
        CHANGES += sum(counts.values())
    return rc


def sync_full(repo_root: Path, remote: str, exclude_file: Path, dry_run: bool,
              rsync: list[str] = RSYNC, quiet: bool = False) -> int:
    """Sync entire repo to remote."""
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        "--delete",
        f"--exclude-from={exclude_file}",
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    return run_rsync(cmd, quiet)


def resolve_in_project(text: str, repo_root: Path) -> str | None:
    """Turn a typed, pasted or dragged path into a path relative to the project root.

    Accepts absolute paths and paths relative to the current directory or the
    project root. Returns None if it does not exist or lies outside the project.
    """
    text = text.strip()
    try:
        parts = shlex.split(text)  # undo quotes and backslash-escaped spaces from drag and drop
    except ValueError:
        parts = []
    if len(parts) == 1:
        text = parts[0]
    if not text:
        return None
    path = Path(os.path.expanduser(text))
    candidates = [path] if path.is_absolute() else [Path.cwd() / path, repo_root / path]
    for candidate in candidates:
        if candidate.exists():
            try:
                return str(candidate.resolve().relative_to(repo_root.resolve()))
            except ValueError:
                continue
    return None


def sync_path(rel: str, repo_root: Path, remote: str, exclude_file: Path, dry_run: bool,
              rsync: list[str] = RSYNC) -> int:
    """Sync one file, or mirror one folder, keeping its relative path on the remote."""
    if rel == ".":
        return sync_full(repo_root, remote, exclude_file, dry_run, rsync)
    mirror = exclude_file if (repo_root / rel).is_dir() else None
    return sync_batch([rel], repo_root, remote, dry_run, rsync, mirror_excludes=mirror)


def inside_remote(rels: list[str]) -> list[str]:
    """Drop relative paths that could resolve outside the remote project directory."""
    safe = []
    for rel in rels:
        if not rel or rel.startswith("/") or ".." in Path(rel).parts or "\n" in rel or "\r" in rel:
            print(f"warning: skipping path outside the project: {rel!r}")
        else:
            safe.append(rel)
    return safe


def sync_batch(batch: list[str], repo_root: Path, remote: str, dry_run: bool = False,
               rsync: list[str] = RSYNC, delete_missing: bool = False, quiet: bool = False,
               mirror_excludes: Path | None = None) -> int:
    """Sync a batch of relative paths using rsync --files-from.

    --files-from implies --relative, so missing parent directories are created.
    With delete_missing, listed files that no longer exist locally are deleted
    on the remote. With mirror_excludes (an exclude file), listed folders are
    mirrored like a full sync: sent recursively, with remote extras deleted.
    """
    batch = inside_remote(batch)
    if not batch:
        return 0
    files_from = repo_root / ".xsync.files"
    files_from.write_text("\n".join(batch) + "\n")
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        *(["-r", "--delete", f"--exclude-from={mirror_excludes}"] if mirror_excludes else []),
        "--files-from", str(files_from),
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    if delete_missing:
        cmd.insert(1, "--delete-missing-args")
    try:
        rc = run_rsync(cmd, quiet)
    finally:
        files_from.unlink(missing_ok=True)
    return 0 if delete_missing and rc == VANISHED_EXIT_CODE else rc


INTERNAL_FILES = {".xsync.files", ".xsync.exclude"}


def is_ssh_remote(remote: str) -> bool:
    if remote.startswith("/") or remote.startswith("~/") or remote.startswith("./"):
        return False
    return ":" in remote


def ssh_reachable(remote: str, rsync: list[str] = RSYNC, quiet: bool = False) -> bool:
    """Check that the SSH host answers without prompting for a password.

    Probes through rsync instead of running a remote command, so it also
    works with keys that are restricted to rsync (rrsync).
    """
    host = remote.split(":", 1)[0]
    # -T: no terminal, even if ~/.ssh/config sets RequestTTY for this host
    ssh = "ssh -T -o BatchMode=yes -o ConnectTimeout=5"
    cmd = [rsync[0], "-e", ssh, "--list-only", f"{host}:."]
    errors = subprocess.DEVNULL if quiet else None
    return subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=errors).returncode == 0


def normalize_remote(remote: str) -> str:
    """Expand ~ for local remotes and make sure the remote ends with a slash."""
    if not is_ssh_remote(remote):
        remote = os.path.expanduser(remote)
    return remote if remote.endswith("/") else remote + "/"


def unsafe_remote_reason(remote: str) -> str | None:
    """Return why remote is too dangerous for a --delete sync, or None if it is fine."""
    path = remote.split(":", 1)[1] if is_ssh_remote(remote) else os.path.expanduser(remote)
    stripped = path.rstrip("/")
    if not stripped:
        return "the remote path is empty or the filesystem root"
    # "." is the home directory over SSH and the current directory locally
    if os.path.normpath(stripped) in ("~", ".", str(Path.home())):
        return "the remote path is a home (or the current) directory"
    if ".." in Path(stripped).parts:
        return "the remote path contains '..'"
    return None


def missing_parent_dirs(rels: list[str], repo_root: Path) -> list[list[str]]:
    """Folders above the given paths that no longer exist locally, grouped deepest first."""
    by_depth: dict[int, set[str]] = {}
    for rel in rels:
        for parent in Path(rel).parents:
            if parent.parts and not (repo_root / parent).exists():
                by_depth.setdefault(len(parent.parts), set()).add(str(parent))
    return [sorted(by_depth[depth]) for depth in sorted(by_depth, reverse=True)]


def delete_from_remote(deleted_rels: list[str], repo_root: Path, remote: str,
                       rsync: list[str] = RSYNC, quiet: bool = False) -> int:
    """Delete specific files from remote without a full rsync scan.

    Folders that disappeared locally are removed too, but only once they are
    empty on the remote. Over SSH this goes through rsync (--delete-missing-args,
    GNU rsync 3.1+), so no shell command ever runs on the remote host.
    """
    rels = inside_remote(deleted_rels)
    folders = missing_parent_dirs(rels, repo_root)
    if is_ssh_remote(remote):
        rc = sync_batch(rels, repo_root, remote, rsync=rsync, delete_missing=True, quiet=quiet)
        if rc == 0:
            # One pass per depth: rsync only removes a folder that is already empty,
            # and stays silent here about folders that still hold remote-only files
            for level in folders:
                sync_batch(level, repo_root, remote, rsync=rsync, delete_missing=True, quiet=True)
        return rc
    base = Path(remote.rstrip("/"))
    for rel in rels:
        (base / rel).unlink(missing_ok=True)
    for level in folders:
        for folder in level:
            try:
                (base / folder).rmdir()
            except OSError:
                pass  # not empty, or already gone
    return 0


def pattern_matches(pattern: str, parts: tuple[str, ...], is_dir: bool) -> bool:
    """Test one rsync-style exclude pattern against a path given as its components.

    Supports the common subset: a trailing / matches directories only, a leading /
    anchors at the project root, and a pattern containing / matches whole
    components at the end of the path.
    """
    if pattern.endswith("/") and not is_dir:
        return False
    anchored = pattern.startswith("/")
    pat = pattern.strip("/")
    if not pat:
        return False
    if anchored:
        return fnmatch.fnmatch("/".join(parts), pat)
    depth = pat.count("/") + 1
    return len(parts) >= depth and fnmatch.fnmatch("/".join(parts[-depth:]), pat)


def make_excluded_checker(repo_root: Path, patterns: list[str]):
    """Return a function that tests whether a resolved path should be excluded."""
    def is_excluded(abs_path: str) -> bool:
        try:
            rel = Path(abs_path).relative_to(repo_root)
        except ValueError:
            return True
        if rel.name in INTERNAL_FILES:
            return True
        parts = rel.parts
        for pattern in patterns:
            # The file itself, then every directory above it
            if pattern_matches(pattern, parts, is_dir=False):
                return True
            if any(pattern_matches(pattern, parts[:i], is_dir=True) for i in range(1, len(parts))):
                return True
        return False
    return is_excluded


RETRY_SECONDS = 10
# Seconds watch mode collects changes before sending them; `interval` in .xsync.toml overrides it
DEFAULT_INTERVAL = 2.0
HEARTBEAT_SECONDS = 60
IDLE = "in sync, watching for changes"


def run_session(repo_root: Path, remote: str, exclude_patterns: list[str], debounce: float,
                rsync: list[str], status, can_summarize: bool, notices: list[str]):
    """The session: compare, sync and watch on single key presses.

    status returns the setup rows for the info key. can_summarize says whether
    rsync supports the summarized output (GNU rsync 3.x). notices are warnings
    from startup, shown once the screen is up.
    """
    global PROBLEM_HOOK
    ssh = is_ssh_remote(remote)
    screen = Screen(repo_root.name, remote, "ssh" if ssh else "local")
    screen.verbose = not PRETTY
    is_excluded = make_excluded_checker(repo_root, exclude_patterns)
    pending: set[str] = set()
    deleted: set[str] = set()
    lock = threading.Lock()
    problems: deque[tuple[str, str]] = deque(maxlen=50)
    observer = None
    offline = False
    last_change = ""
    resting = ("not compared yet", "busy")  # what the bar says when idle and not watching

    def clock() -> str:
        return f"{datetime.now():%H:%M:%S}"

    def detail() -> str:
        return f"{CHANGES} changes" + (f" · last {last_change}" if last_change else "")

    def rest():
        """Set the bar to what the session is doing when nothing is running."""
        if offline:
            queued = len(pending) + len(deleted)
            screen.set_status(f"offline, {queued} queued, retrying", "problem", detail(), "offline")
        elif screen.watching:
            screen.set_status(IDLE, "ok", detail(), "watch")
        else:
            screen.set_status(*resting, detail(), "idle")

    def record_problem(text: str):
        problems.append((clock(), text))
        screen.set_message(f"last problem {clock()}: {text}   [e] shows all")

    def reached(codes: list[int]) -> bool:
        """Report rsync exit codes. False when the connection failed."""
        nonlocal offline
        if any(code in CONNECTION_EXIT_CODES for code in codes):
            if not offline:
                offline = True
                warn(f"connection lost; retrying every {RETRY_SECONDS}s", "magenta")
            return False
        if offline:
            offline = False
            emit("reconnected", "green")
        for code in codes:
            if code != 0:
                warn(f"rsync exited with code {code}", "magenta")
        return True

    def full_sync():
        nonlocal resting, last_change
        screen.set_status("syncing…", "busy")
        before = CHANGES
        rc = sync_full(repo_root, remote, exclude_file, False, rsync, quiet=offline)
        if reached([rc]):
            if CHANGES != before:
                last_change = clock()
            elif rc == 0 and PRETTY:
                emit("already up to date", "dim")
            resting = (f"in sync at {clock()[:5]}", "ok") if rc == 0 else (f"sync had errors at {clock()[:5]}", "problem")
        rest()

    def compare():
        nonlocal resting
        screen.set_status("comparing…", "busy")
        rc = sync_full(repo_root, remote, exclude_file, True, rsync, quiet=offline)
        if reached([rc]) and not PRETTY:
            resting = (f"compared at {clock()[:5]}", "busy")  # raw output: the count is not known
        elif not offline:
            differences = sum(LAST_COUNTS.values())
            if differences:
                emit(f"{differences} difference(s), nothing changed; press s to sync", "dim")
                resting = (f"{differences} differences at {clock()[:5]}", "busy")
            elif rc == 0:
                emit("no differences", "dim")
                resting = (f"in sync at {clock()[:5]}", "ok")
        rest()

    def start_watch():
        nonlocal observer
        try:
            from watchdog.observers import Observer
            from watchdog.events import FileSystemEventHandler
        except ImportError:
            warn("watch mode needs watchdog, which is not installed (pip install watchdog)", "magenta")
            return

        class Handler(FileSystemEventHandler):
            def _handle(self, abs_path: str):
                if is_excluded(abs_path):
                    return
                try:
                    rel = str(Path(abs_path).relative_to(repo_root))
                except ValueError:
                    return
                with lock:
                    pending.add(rel)

            def on_modified(self, event):
                if not event.is_directory:
                    self._handle(event.src_path)

            def on_created(self, event):
                if not event.is_directory:
                    self._handle(event.src_path)

            def on_moved(self, event):
                if not event.is_directory:
                    # src is gone on remote; dest needs to be pushed
                    self._handle(event.dest_path)
                    # Excluded paths are never ours to delete on the remote
                    if is_excluded(event.src_path):
                        return
                    try:
                        rel = str(Path(event.src_path).relative_to(repo_root))
                        with lock:
                            deleted.add(rel)
                    except ValueError:
                        pass

            def on_deleted(self, event):
                if event.is_directory:
                    return
                if is_excluded(event.src_path):
                    return
                try:
                    rel = str(Path(event.src_path).relative_to(repo_root))
                except ValueError:
                    return
                with lock:
                    pending.discard(rel)
                    deleted.add(rel)

        # Start listening before the full sync, so nothing changed meanwhile is missed
        observer = Observer()
        observer.schedule(Handler(), str(repo_root), recursive=True)
        observer.start()
        screen.watching = True
        full_sync()

    def stop_watch():
        nonlocal observer
        observer.stop()
        observer.join()
        observer = None
        with lock:
            pending.clear()
            deleted.clear()
        screen.watching = False
        emit("watch off", "dim")
        rest()

    def flush():
        """Send what the watcher collected since the last flush."""
        nonlocal last_change
        with lock:
            batch = list(pending)
            pending.clear()
            removals = list(deleted)
            deleted.clear()

        # Anything "deleted" that still exists was overwritten (atomic write) — sync it
        overwritten = [f for f in removals if (repo_root / f).exists()]
        removals = [f for f in removals if not (repo_root / f).exists()]
        batch = list(set(batch) | set(overwritten))

        # Drop batch entries that no longer exist (temp files from atomic writes)
        batch = [f for f in batch if (repo_root / f).exists()]

        if not batch and not removals:
            return
        if not offline:
            screen.set_status("syncing…", "busy")
        before = CHANGES
        codes = []
        if removals:
            if not PRETTY and not offline:
                emit(f"deleting {len(removals)} file(s): {', '.join(removals)}")
            codes.append(delete_from_remote(removals, repo_root, remote, rsync, quiet=offline))
        if batch:
            if not PRETTY and not offline:
                emit(f"syncing {len(batch)} file(s): {', '.join(batch)}")
            codes.append(sync_batch(batch, repo_root, remote, rsync=rsync, quiet=offline))
        if not reached(codes):
            # Keep the changes and try again until the connection is back
            with lock:
                pending.update(batch)
                deleted.update(removals)
        elif CHANGES != before:
            last_change = clock()
        rest()

    def sync_one():
        nonlocal last_change
        text = screen.ask("file or folder to sync (type, paste or drag it here)")
        if not text:
            return
        rel = resolve_in_project(text, repo_root)
        if rel is None:
            warn(f"not found inside the project: {text.strip()}", "magenta")
            return
        screen.set_status(f"syncing {rel}…", "busy")
        before = CHANGES
        rc = sync_path(rel, repo_root, remote, exclude_file, False, rsync)
        if reached([rc]):
            if CHANGES != before:
                last_change = clock()
            elif rc == 0 and PRETTY:
                emit(f"{rel}: already up to date", "dim")
        rest()

    def check_connection(announce: bool):
        """Probe the host; go offline or come back online accordingly."""
        if not ssh:
            if announce:
                emit("local remote, no connection to check", "dim")
            return
        if announce:
            screen.set_status("connecting…", "busy")
        was_offline = offline
        if ssh_reachable(remote, rsync, quiet=True):
            reached([0])
            if announce and not was_offline:
                emit("connection ok", "dim")
            if was_offline and screen.watching:
                flush()
        else:
            reached([255])
        rest()

    def show_problems():
        if not problems:
            emit("no problems recorded", "dim")
        for when, text in problems:
            emit(f"! {when}  {text}", "yellow")
        problems.clear()
        screen.set_message("")

    def show_status():
        """List the resolved setup, as `xsync --status` does."""
        screen.set_status("checking…", "busy")
        rows, _ = status()
        for label, value in rows:
            emit(f"{label.ljust(11)} {value}", "dim")
        rest()

    def toggle_verbose():
        global PRETTY
        if not can_summarize:
            warn("the summarized output needs GNU rsync 3.x; staying verbose", "magenta")
            return
        PRETTY = not PRETTY
        screen.verbose = not PRETTY
        emit("verbose on: showing rsync's raw output" if screen.verbose else "verbose off", "dim")
        rest()

    def show_help():
        emit(f"xsync {__version__}", "bold")
        for keys in SESSION_KEYS:
            for key, _ in keys:
                emit(f"{key}   {KEY_HELP[key]}", "dim")

    actions = {"s": full_sync, "c": compare, "f": sync_one, "e": show_problems, "i": show_status,
               "v": toggle_verbose, "h": show_help,
               "r": lambda: check_connection(announce=True),
               "w": lambda: stop_watch() if screen.watching else start_watch()}

    exclude_file = write_exclude_file(repo_root, exclude_patterns)
    PROBLEM_HOOK = record_problem
    try:
        with screen:
            for notice in notices:
                warn(notice)
            compare()
            last_flush = last_beat = time.monotonic()
            while True:
                key = screen.read_key(0.2)
                if key == "q":
                    break
                if key in actions:
                    actions[key]()
                now = time.monotonic()
                if screen.watching and now - last_flush >= (RETRY_SECONDS if offline else debounce):
                    last_flush = now
                    flush()
                # Notice a dropped connection without waiting for the next change
                if now - last_beat >= (RETRY_SECONDS if offline else HEARTBEAT_SECONDS):
                    last_beat = now
                    check_connection(announce=False)
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        PROBLEM_HOOK = None
        if observer is not None:
            observer.stop()
            observer.join()
        exclude_file.unlink(missing_ok=True)


def status_rows(repo_root: Path, config: dict, remote: str, rsync: list[str], version: str) -> tuple[list, bool]:
    """The resolved setup as (label, value) rows, and whether a sync could run."""
    ssh = is_ssh_remote(remote)
    found = re.search(r"version\s+(\S+)", version)
    flavor = f"GNU rsync {found.group(1)}" if is_gnu_rsync3(version) and found else "not GNU rsync 3.x"
    try:
        import watchdog  # noqa: F401
        watching = "available"
    except ImportError:
        watching = "watchdog is not installed (pip install watchdog)"
    reason = unsafe_remote_reason(remote)
    if not ssh:
        reachable = "folder exists" if Path(remote).is_dir() else "folder not found"
    else:
        reachable = "reachable" if ssh_reachable(remote, rsync, quiet=True) else "not reachable"
    rows = [
        ("version", f"xsync {__version__}"),
        ("project", str(repo_root)),
        ("config", str(repo_root / ".xsync.toml")),
        ("remote", f"{remote}  ({'ssh' if ssh else 'local path'})"),
        ("host" if ssh else "target", reachable),
        ("full sync", "allowed" if reason is None else f"refused: {reason}"),
        ("rsync", f"{rsync[0]}  ({flavor})"),
        ("rsync_args", " ".join(config.get("rsync_args", [])) or "none"),
        ("exclude", f"{len(config.get('exclude', []))} patterns"),
        ("interval", f"{float(config.get('interval', DEFAULT_INTERVAL)):g}s between watch batches"),
        ("watch mode", watching),
    ]
    return rows, reason is None and reachable in ("reachable", "folder exists")


def cmd_init():
    """Scaffold a starter .xsync.toml in the current directory."""
    target = Path.cwd() / ".xsync.toml"
    if target.exists():
        print(f"Already exists: {target}")
        sys.exit(1)
    target.write_text(STARTER_CONFIG)
    print(f"Created {target}")
    print("Edit the 'remote' line in it to point to your destination.")


def offer_init():
    """No config found: offer to create one on a key press, then exit."""
    import termios
    import tty
    print("No .xsync.toml found in this folder or any parent.")
    print(f"Press i to create a starter config in {Path.cwd()}, or any other key to quit.")
    fd = sys.stdin.fileno()
    settings = termios.tcgetattr(fd)
    try:
        tty.setcbreak(fd)
        key = os.read(fd, 1).decode("utf-8", "ignore")
    finally:
        termios.tcsetattr(fd, termios.TCSADRAIN, settings)
    if key != "i":
        sys.exit(1)
    cmd_init()
    print("Then run `xsync` again.")


KNOWN_FLAGS = {"--init", "--verbose", "--version", "--help", "-h"}


def main():
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return

    if "--version" in args:
        print(f"xsync {__version__}")
        return

    # Syncing only ever happens on a key press inside the session
    unknown = [a for a in args if a not in KNOWN_FLAGS]
    if unknown:
        print(f"error: unknown argument: {' '.join(unknown)}")
        print("   Run `xsync` and use the keys, or `xsync --help`.")
        sys.exit(2)

    if "--init" in args:
        cmd_init()
        return

    if not (sys.stdin.isatty() and sys.stdout.isatty()):
        print("error: xsync needs a terminal. Run `xsync` in a terminal and use the keys.")
        sys.exit(1)

    result = find_config(Path.cwd())
    if result is None:
        offer_init()
        return

    repo_root, config = result
    remote = config.get("remote")
    if not remote:
        print("error: 'remote' not set in .xsync.toml.")
        sys.exit(1)

    remote = normalize_remote(remote)
    exclude_patterns = config.get("exclude", [])

    rsync = resolve_rsync(config)
    try:
        version = subprocess.run([rsync, "--version"], capture_output=True, text=True).stdout
    except OSError:
        print(f"error: rsync not found: {rsync}")
        sys.exit(1)
    global PRETTY
    notices = []
    gnu = is_gnu_rsync3(version)
    PRETTY = gnu and "--verbose" not in args
    if not gnu:
        notices.append(f"{rsync} is not GNU rsync 3.x; some flags may behave differently (brew install rsync)")
    extra_args = list(config.get("rsync_args", []))
    if is_ssh_remote(remote) and "RSYNC_RSH" not in os.environ:
        # Before the user's flags, so an -e in rsync_args still wins
        extra_args = ["-e", SSH_COMMAND, *extra_args]
    rsync = [rsync, *extra_args]

    # Full syncs run rsync --delete
    reason = unsafe_remote_reason(remote)
    if reason:
        print(f"error: refusing to sync with --delete to '{remote}': {reason}.")
        print("   Point 'remote' in .xsync.toml at a dedicated project directory.")
        sys.exit(1)

    if is_ssh_remote(remote) and not ssh_reachable(remote, rsync):
        host = remote.split(":", 1)[0]
        print(f"error: cannot reach '{host}' over SSH.")
        print("   Host unreachable, key not loaded (ssh-add), or VPN not connected.")
        print(f"   Try: rsync --list-only {host}:.")
        sys.exit(1)

    run_session(repo_root, remote, exclude_patterns, float(config.get("interval", DEFAULT_INTERVAL)), rsync,
                status=lambda: status_rows(repo_root, config, remote, rsync, version),
                can_summarize=gnu, notices=notices)


if __name__ == "__main__":
    main()
