# that rejects permission, ownership and timestamp changes; see the README.
# rsync_args = ["--no-perms", "--no-owner", "--no-group", "--no-times", "--omit-dir-times", "--inplace", "--checksum"]
"""


def find_config(start: Path) -> tuple[Path, dict] | None:
    """Walk up from start, looking for .xsync.toml. Returns (repo_root, config)."""
    for directory in [start, *start.parents]:
        config_path = directory / ".xsync.toml"
        if config_path.exists():
            with open(config_path, "rb") as f:
                return directory, tomllib.load(f)
    return None


def write_exclude_file(repo_root: Path, patterns: list[str]) -> Path:
    """Write exclude patterns to a temp file rsync can consume."""
    exclude_path = repo_root / ".xsync.exclude"
    exclude_path.write_text("\n".join(patterns) + "\n")
    return exclude_path


HOMEBREW_RSYNC = "/opt/homebrew/bin/rsync"
# Default rsync command prefix: binary plus any extra args from the config
RSYNC = ["rsync"]


def resolve_rsync(config: dict) -> str:
    """Pick the rsync binary: config key, then Homebrew's, then whatever is on PATH."""
    configured = config.get("rsync")
    if configured:
        return os.path.expanduser(configured)
    return HOMEBREW_RSYNC if os.path.exists(HOMEBREW_RSYNC) else "rsync"


def is_gnu_rsync3(version_output: str) -> bool:
    """True if `rsync --version` output looks like GNU rsync 3.x (not openrsync)."""
    if "openrsync" in version_output:
        return False
    return re.match(r"rsync\s+version\s+3\.", version_output) is not None


# Set by main(): summarize rsync's output instead of passing it through.
# Needs GNU rsync 3.x; --verbose and other rsync flavors keep the raw output.
PRETTY = False
# Set by cmd_watch(): prefix each output line with the time
STAMP = False
# Number of new, updated and deleted paths reported so far
CHANGES = 0

COLORS = {
    "green": "32", "blue": "34", "red": "31", "yellow": "33", "magenta": "35", "dim": "2", "bold": "1",
    # header badges, one per mode
    "sync": "1;7;34", "dry-run": "1;7;33", "file": "1;7;36", "watch": "1;7;32", "offline": "1;7;35", "status": "1;7",
}


def colors_on() -> bool:
    return sys.stdout.isatty() and "NO_COLOR" not in os.environ


def paint(text: str, color: str | None) -> str:
    """Color text for a terminal; plain when piped or when NO_COLOR is set."""
    if color is None or not colors_on():
        return text
    return f"\033[{COLORS[color]}m{text}\033[0m"


def emit(text: str, color: str | None = None):
    """Print one line below the header: time-stamped while watching, indented otherwise."""
    prefix = f"{datetime.now():%H:%M:%S}  " if STAMP else "  "
    print(prefix + paint(text, color), flush=True)


def format_header(mode: str, name: str, remote: str, info: str = "", width: int | None = None) -> str:
    """The header line: the mode, what is synced where, and optional details.

    With a width, the line is shortened to fit: the middle part first, then
    the details are dropped.
    """
    lead = f" {mode.upper()} " if colors_on() else f"xsync {mode}"
    middle = f"{name} → {remote}"
    if width is not None:
        def length() -> int:
            return len(lead) + 2 + len(middle) + (2 + len(info) if info else 0)
        if length() > width:
            keep = max(len(middle) - (length() - width), 30)
            if keep < len(middle):
                middle = middle[:keep - 1] + "…"
        if length() > width:
            info = ""
        if length() > width:
            middle = middle[:max(width - len(lead) - 3, 0)] + "…"
    line = paint(lead, mode) + "  " + paint(middle, "bold")
    return line + ("  " + paint(info, "dim") if info else "")


class PinnedHeader:
    """The watch-mode header, fixed at the top of the terminal while output scrolls below it.

    Uses a terminal scroll region. When output is not a terminal, or with raw
    rsync output, the header is simply printed once.
    """

    def __init__(self, name: str, remote: str, transport: str):
        self.name, self.remote, self.transport = name, remote, transport
        self.mode, self.status = "watch", ""
        self.pinned = PRETTY and sys.stdout.isatty()

    def line(self, width: int | None = None) -> str:
        info = " · ".join(part for part in (self.transport, self.status, "Ctrl+C to stop") if part)
        return format_header(self.mode, self.name, self.remote, info, width)

    def draw(self, clear: bool = False):
        size = shutil.get_terminal_size()
        rule = paint("─" * (size.columns - 1), "dim")
        # Setting the scroll region moves the cursor, so save and restore it
        start = "\033[2J" if clear else "\0337"
        end = "\033[3;1H" if clear else "\0338"
        sys.stdout.write(
            f"{start}\033[3;{size.lines}r"
            f"\033[1;1H\033[2K{self.line(size.columns - 1)}"
            f"\033[2;1H\033[2K{rule}{end}"
        )
        sys.stdout.flush()

    def set_status(self, status: str, mode: str = "watch"):
        self.status, self.mode = status, mode
        if self.pinned:
            self.draw()

    def __enter__(self):
        if not self.pinned:
            print(self.line(), flush=True)
            return self
        self.draw(clear=True)
        if hasattr(signal, "SIGWINCH"):
            signal.signal(signal.SIGWINCH, lambda *_: self.draw())
        return self

    def __exit__(self, *exc):
        if self.pinned:
            if hasattr(signal, "SIGWINCH"):
                signal.signal(signal.SIGWINCH, signal.SIG_DFL)
            sys.stdout.write("\0337\033[r\0338")
            sys.stdout.flush()
        return False


def rsync_flags(remote: str) -> str:
    """Base rsync flags. Compression only pays off over the network."""
    flags = "-a" if PRETTY else "-av"
    return flags + "z" if is_ssh_remote(remote) else flags


def parse_change(line: str) -> tuple[str, str]:
    """Classify one line of `rsync --out-format='%i %n%L'` output.

    Returns (kind, text) with kind one of new, updated, deleted, skip, message.
    """
    if not line.strip():
        return "skip", ""
    if line.startswith("*deleting"):
        return "deleted", line[len("*deleting"):].strip()
    if len(line) > 12 and line[0] in "<>ch." and line[1] in "fdLDS" and line[11] == " ":
        code, name = line[:11], line[12:]
        if code[0] == ".":
            return "skip", name  # attributes only, no content sent
        return ("new" if "+++++++++" in code else "updated"), name
    return "message", line


# rsync's complaints about source files that are gone. When deleting remote
# copies of locally deleted files, that is the expected state, not a problem.
VANISHED_MESSAGES = ("file has vanished:", "WARNING: parent dir is absent", "rsync warning: some files vanished")
VANISHED_EXIT_CODE = 24
# rsync exit codes that mean the connection failed, so a retry can help:
# socket I/O, protocol stream, timeouts, and ssh's own failure code
CONNECTION_EXIT_CODES = {10, 12, 30, 35, 255}

# No prompts, and notice a dead connection within about a minute instead of hanging
SSH_COMMAND = "ssh -T -o BatchMode=yes -o ConnectTimeout=10 -o ServerAliveInterval=15 -o ServerAliveCountMax=3"

CHANGE_MARKS = {"new": ("+", "green"), "updated": ("~", "blue"), "deleted": ("-", "red")}


def run_rsync(cmd: list[str], quiet: bool = False) -> int:
    """Run rsync. With PRETTY, print one short line per change instead of rsync's output.

    quiet hides rsync's messages and errors (changes are still shown).
    """
    global CHANGES
    if not PRETTY:
        silence = subprocess.DEVNULL if quiet else None
        return subprocess.run(cmd, stdout=silence, stderr=silence).returncode
    cmd = [cmd[0], "--out-format=%i %n%L", "--outbuf=L", *cmd[1:]]
    counts = {"new": 0, "updated": 0, "deleted": 0}
    seen_messages = set()
    deleting_missing = "--delete-missing-args" in cmd
    start = time.monotonic()
    proc = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, errors="replace")
    for line in proc.stdout:
        kind, text = parse_change(line.rstrip("\n"))
        if kind in counts:
            counts[kind] += 1
            mark, color = CHANGE_MARKS[kind]
            emit(f"{mark} {text}", color)
        elif kind == "message" and not quiet and text not in seen_messages:
            if deleting_missing and text.startswith(VANISHED_MESSAGES):
                continue
            seen_messages.add(text)
            emit(f"! {text}", "yellow")
    rc = proc.wait()
    CHANGES += sum(counts.values())
    if not STAMP:
        would = "would be " if "--dry-run" in cmd else ""
        changes = ", ".join(f"{n} {would}{kind}" for kind, n in counts.items() if n)
        print(paint(f"{changes or 'Already up to date'} · {time.monotonic() - start:.1f}s", "dim"), flush=True)
    return rc


def sync_full(repo_root: Path, remote: str, exclude_file: Path, dry_run: bool, rsync: list[str] = RSYNC) -> int:
    """Sync entire repo to remote."""
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        "--delete",
        f"--exclude-from={exclude_file}",
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    return run_rsync(cmd)


def sync_file(file_path: Path, repo_root: Path, remote: str, dry_run: bool, rsync: list[str] = RSYNC) -> int:
    """Sync a single file, preserving its relative path in the remote."""
    rel = file_path.resolve().relative_to(repo_root)
    return sync_batch([str(rel)], repo_root, remote, dry_run, rsync)


def inside_remote(rels: list[str]) -> list[str]:
    """Drop relative paths that could resolve outside the remote project directory."""
    safe = []
    for rel in rels:
        if not rel or rel.startswith("/") or ".." in Path(rel).parts or "\n" in rel or "\r" in rel:
            print(f"warning: skipping path outside the project: {rel!r}")
        else:
            safe.append(rel)
    return safe


def sync_batch(batch: list[str], repo_root: Path, remote: str, dry_run: bool = False,
               rsync: list[str] = RSYNC, delete_missing: bool = False, quiet: bool = False) -> int:
    """Sync a batch of relative file paths using rsync --files-from.

    --files-from implies --relative, so missing parent directories are created.
    With delete_missing, listed files that no longer exist locally are deleted
    on the remote.
    """
    batch = inside_remote(batch)
    if not batch:
        return 0
    files_from = repo_root / ".xsync.files"
    files_from.write_text("\n".join(batch) + "\n")
    cmd = [
        rsync[0],
        rsync_flags(remote),
        *rsync[1:],  # extra args go after -a so they can override it
        "--files-from", str(files_from),
        str(repo_root) + "/",
        remote,
    ]
    if dry_run:
        cmd.insert(1, "--dry-run")
    if delete_missing:
        cmd.insert(1, "--delete-missing-args")
    try:
        rc = run_rsync(cmd, quiet)
    finally:
        files_from.unlink(missing_ok=True)
    return 0 if delete_missing and rc == VANISHED_EXIT_CODE else rc


INTERNAL_FILES = {".xsync.files", ".xsync.exclude"}


def is_ssh_remote(remote: str) -> bool:
    if remote.startswith("/") or remote.startswith("~/") or remote.startswith("./"):
        return False
    return ":" in remote


def ssh_reachable(remote: str, rsync: list[str] = RSYNC) -> bool:
    """Check that the SSH host answers without prompting for a password.

    Probes through rsync instead of running a remote command, so it also
    works with keys that are restricted to rsync (rrsync).
    """
    host = remote.split(":", 1)[0]
    # -T: no terminal, even if ~/.ssh/config sets RequestTTY for this host
    ssh = "ssh -T -o BatchMode=yes -o ConnectTimeout=5"
    cmd = [rsync[0], "-e", ssh, "--list-only", f"{host}:."]
    return subprocess.run(cmd, stdout=subprocess.DEVNULL).returncode == 0


def normalize_remote(remote: str) -> str:
    """Expand ~ for local remotes and make sure the remote ends with a slash."""
    if not is_ssh_remote(remote):
        remote = os.path.expanduser(remote)
    return remote if remote.endswith("/") else remote + "/"


def unsafe_remote_reason(remote: str) -> str | None:
    """Return why remote is too dangerous for a --delete sync, or None if it is fine."""
    path = remote.split(":", 1)[1] if is_ssh_remote(remote) else os.path.expanduser(remote)
    stripped = path.rstrip("/")
    if not stripped:
        return "the remote path is empty or the filesystem root"
    # "." is the home directory over SSH and the current directory locally
    if os.path.normpath(stripped) in ("~", ".", str(Path.home())):
        return "the remote path is a home (or the current) directory"
    if ".." in Path(stripped).parts:
        return "the remote path contains '..'"
    return None


def missing_parent_dirs(rels: list[str], repo_root: Path) -> list[list[str]]:
    """Folders above the given paths that no longer exist locally, grouped deepest first."""
    by_depth: dict[int, set[str]] = {}
    for rel in rels:
        for parent in Path(rel).parents:
            if parent.parts and not (repo_root / parent).exists():
                by_depth.setdefault(len(parent.parts), set()).add(str(parent))
    return [sorted(by_depth[depth]) for depth in sorted(by_depth, reverse=True)]


def delete_from_remote(deleted_rels: list[str], repo_root: Path, remote: str,
                       rsync: list[str] = RSYNC, quiet: bool = False) -> int:
    """Delete specific files from remote without a full rsync scan.

    Folders that disappeared locally are removed too, but only once they are
    empty on the remote. Over SSH this goes through rsync (--delete-missing-args,
    GNU rsync 3.1+), so no shell command ever runs on the remote host.
    """
    rels = inside_remote(deleted_rels)
    folders = missing_parent_dirs(rels, repo_root)
    if is_ssh_remote(remote):
        rc = sync_batch(rels, repo_root, remote, rsync=rsync, delete_missing=True, quiet=quiet)
        if rc == 0:
            # One pass per depth: rsync only removes a folder that is already empty,
            # and stays silent here about folders that still hold remote-only files
            for level in folders:
                sync_batch(level, repo_root, remote, rsync=rsync, delete_missing=True, quiet=True)
        return rc
    base = Path(remote.rstrip("/"))
    for rel in rels:
        (base / rel).unlink(missing_ok=True)
    for level in folders:
        for folder in level:
            try:
                (base / folder).rmdir()
            except OSError:
                pass  # not empty, or already gone
    return 0


def pattern_matches(pattern: str, parts: tuple[str, ...], is_dir: bool) -> bool:
    """Test one rsync-style exclude pattern against a path given as its components.

    Supports the common subset: a trailing / matches directories only, a leading /
    anchors at the project root, and a pattern containing / matches whole
    components at the end of the path.
    """
    if pattern.endswith("/") and not is_dir:
        return False
    anchored = pattern.startswith("/")
    pat = pattern.strip("/")
    if not pat:
        return False
    if anchored:
        return fnmatch.fnmatch("/".join(parts), pat)
    depth = pat.count("/") + 1
    return len(parts) >= depth and fnmatch.fnmatch("/".join(parts[-depth:]), pat)


def make_excluded_checker(repo_root: Path, patterns: list[str]):
    """Return a function that tests whether a resolved path should be excluded."""
    def is_excluded(abs_path: str) -> bool:
        try:
            rel = Path(abs_path).relative_to(repo_root)
        except ValueError:
            return True
        if rel.name in INTERNAL_FILES:
            return True
        parts = rel.parts
        for pattern in patterns:
            # The file itself, then every directory above it
            if pattern_matches(pattern, parts, is_dir=False):
                return True
            if any(pattern_matches(pattern, parts[:i], is_dir=True) for i in range(1, len(parts))):
                return True
        return False
    return is_excluded


RETRY_SECONDS = 10


def cmd_watch(repo_root: Path, remote: str, exclude_patterns: list[str], debounce: float, rsync: list[str] = RSYNC):
    try:
        from watchdog.observers import Observer
        from watchdog.events import FileSystemEventHandler
    except ImportError:
        print("error: watchdog is not installed. Run: pip install watchdog")
        sys.exit(1)

    is_excluded = make_excluded_checker(repo_root, exclude_patterns)
    pending: set[str] = set()
    deleted: set[str] = set()
    lock = threading.Lock()

    class Handler(FileSystemEventHandler):
        def _handle(self, abs_path: str):
            if is_excluded(abs_path):
                return
            try:
                rel = str(Path(abs_path).relative_to(repo_root))
            except ValueError:
                return
            with lock:
                pending.add(rel)

        def on_modified(self, event):
            if not event.is_directory:
                self._handle(event.src_path)

        def on_created(self, event):
            if not event.is_directory:
                self._handle(event.src_path)

        def on_moved(self, event):
            if not event.is_directory:
                # src is gone on remote; dest needs to be pushed
                self._handle(event.dest_path)
                # Excluded paths are never ours to delete on the remote
                if is_excluded(event.src_path):
                    return
                try:
                    rel = str(Path(event.src_path).relative_to(repo_root))
                    with lock:
                        deleted.add(rel)
                except ValueError:
                    pass

        def on_deleted(self, event):
            if event.is_directory:
                return
            if is_excluded(event.src_path):
                return
            try:
                rel = str(Path(event.src_path).relative_to(repo_root))
            except ValueError:
                return
            with lock:
                pending.discard(rel)
                deleted.add(rel)

    observer = Observer()
    observer.schedule(Handler(), str(repo_root), recursive=True)
    observer.start()

    exclude_file = write_exclude_file(repo_root, exclude_patterns)

    global STAMP
    STAMP = True
    header = PinnedHeader(repo_root.name, remote, "ssh" if is_ssh_remote(remote) else "local")
    total = 0
    offline = False
    try:
        with header:
            rc = sync_full(repo_root, remote, exclude_file, dry_run=False, rsync=rsync)
            if rc != 0:
                emit(f"! initial sync failed: rsync exited with code {rc}", "magenta")
            else:
                emit("in sync, watching for changes", "dim")
            total = CHANGES
            header.set_status(f"{total} changes · last {datetime.now():%H:%M:%S}")

            while True:
                time.sleep(RETRY_SECONDS if offline else debounce)
                with lock:
                    batch = list(pending)
                    pending.clear()
                    removals = list(deleted)
                    deleted.clear()

                # Anything "deleted" that still exists was overwritten (atomic write) — sync it
                overwritten = [f for f in removals if (repo_root / f).exists()]
                removals = [f for f in removals if not (repo_root / f).exists()]
                batch = list(set(batch) | set(overwritten))

                # Drop batch entries that no longer exist (temp files from atomic writes)
                batch = [f for f in batch if (repo_root / f).exists()]

                if not batch and not removals:
                    continue

                codes = []
                if removals:
                    if not PRETTY and not offline:
                        emit(f"deleting {len(removals)} file(s): {', '.join(removals)}")
                    codes.append(delete_from_remote(removals, repo_root, remote, rsync, quiet=offline))
                if batch:
                    if not PRETTY and not offline:
                        emit(f"syncing {len(batch)} file(s): {', '.join(batch)}")
                    codes.append(sync_batch(batch, repo_root, remote, rsync=rsync, quiet=offline))

                if any(code in CONNECTION_EXIT_CODES for code in codes):
                    # Keep the changes and try again until the connection is back
                    with lock:
                        pending.update(batch)
                        deleted.update(removals)
                    if not offline:
                        offline = True
                        emit(f"! connection lost; changes are queued and retried every {RETRY_SECONDS}s", "magenta")
                    header.set_status(f"{len(batch) + len(removals)} queued", "offline")
                    continue

                if offline:
                    offline = False
                    emit("reconnected; queued changes sent", "green")
                for code in codes:
                    if code != 0:
                        emit(f"! rsync exited with code {code}", "magenta")
                total = CHANGES
                header.set_status(f"{total} changes · last {datetime.now():%H:%M:%S}")
    except KeyboardInterrupt:
        print("\nStopped.")
    finally:
        observer.stop()
        exclude_file.unlink(missing_ok=True)
    observer.join()


def cmd_status(repo_root: Path, config: dict, remote: str, rsync: list[str], version: str) -> int:
    """Show the resolved setup and check the host, without syncing anything."""
    ssh = is_ssh_remote(remote)
    found = re.search(r"version\s+(\S+)", version)
    flavor = f"GNU rsync {found.group(1)}" if is_gnu_rsync3(version) and found else "not GNU rsync 3.x"
    try:
        import watchdog  # noqa: F401
        watching = "available"
    except ImportError:
        watching = "watchdog is not installed (pip install watchdog)"
    reason = unsafe_remote_reason(remote)
    if not ssh:
        reachable = "folder exists" if Path(remote).is_dir() else "folder not found"
    else:
        reachable = "reachable" if ssh_reachable(remote, rsync) else "not reachable"
    ok = reason is None and reachable in ("reachable", "folder exists")

    print(format_header("status", repo_root.name, remote))
    rows = [
        ("project", str(repo_root)),
        ("config", str(repo_root / ".xsync.toml")),
        ("remote", f"{remote}  ({'ssh' if ssh else 'local path'})"),
        ("host" if ssh else "target", reachable),
        ("full sync", "allowed" if reason is None else f"refused: {reason}"),
        ("rsync", f"{rsync[0]}  ({flavor})"),
        ("rsync_args", " ".join(config.get("rsync_args", [])) or "none"),
        ("exclude", f"{len(config.get('exclude', []))} patterns"),
        ("--watch", watching),
    ]
    for label, value in rows:
        print(f"  {paint(label.ljust(11), 'dim')} {value}")
    return 0 if ok else 1


def cmd_init():
    """Scaffold a starter .xsync.toml in the current directory."""
    target = Path.cwd() / ".xsync.toml"
    if target.exists():
        print(f"Already exists: {target}")
        sys.exit(1)
    target.write_text(STARTER_CONFIG)
    print(f"Created {target}")
    print("Edit the 'remote' field to point to your destination.")


def parse_flag_value(args: list[str], flag: str, default):
    """Return the value after --flag if present, else default."""
    if flag in args:
        idx = args.index(flag)
        if idx + 1 < len(args):
            return args[idx + 1]
    return default


KNOWN_FLAGS = {"--init", "--dry-run", "--watch", "--interval", "--status", "--verbose", "--version", "--help", "-h"}


def main():
    args = sys.argv[1:]

    if "--help" in args or "-h" in args:
        print(__doc__.strip())
        return

    if "--version" in args:
        print(f"xsync {__version__}")
        return

    # Never fall through to a sync on a mistyped option
    unknown = [a for a in args if a.startswith("-") and a not in KNOWN_FLAGS]
    if unknown:
        print(f"error: unknown option: {' '.join(unknown)}")
        print("   Run `xsync --help` for usage.")
        sys.exit(2)

    if "--init" in args:
        cmd_init()
        return

    watch = "--watch" in args
    dry_run = "--dry-run" in args
    interval_value = parse_flag_value(args, "--interval", None)
    positional = [a for a in args if not a.startswith("-") and a != interval_value]
    if len(positional) > 1:
        print(f"error: expected at most one file, got: {' '.join(positional)}")
        sys.exit(2)
    file_arg = positional[0] if positional else None

    result = find_config(Path.cwd())
    if result is None:
        print("error: no .xsync.toml found in current directory or any parent.")
        print("   Run `xsync --init` to create one here.")
        sys.exit(1)

    repo_root, config = result
    remote = config.get("remote")
    if not remote:
        print("error: 'remote' not set in .xsync.toml.")
        sys.exit(1)

    remote = normalize_remote(remote)
    exclude_patterns = config.get("exclude", [])

    rsync = resolve_rsync(config)
    try:
        version = subprocess.run([rsync, "--version"], capture_output=True, text=True).stdout
    except OSError:
        print(f"error: rsync not found: {rsync}")
        sys.exit(1)
    global PRETTY
    if is_gnu_rsync3(version):
        PRETTY = "--verbose" not in args
    else:
        print(f"warning: {rsync} is not GNU rsync 3.x; some flags may behave differently (brew install rsync).")
    extra_args = list(config.get("rsync_args", []))
    if is_ssh_remote(remote) and "RSYNC_RSH" not in os.environ:
        # Before the user's flags, so an -e in rsync_args still wins
        extra_args = ["-e", SSH_COMMAND, *extra_args]
    rsync = [rsync, *extra_args]

    if "--status" in args:
        sys.exit(cmd_status(repo_root, config, remote, rsync, version))

    # Full syncs (including the initial one in watch mode) run rsync --delete
    if watch or not file_arg:
        reason = unsafe_remote_reason(remote)
        if reason:
            print(f"error: refusing to sync with --delete to '{remote}': {reason}.")
            print("   Point 'remote' in .xsync.toml at a dedicated project directory.")
            sys.exit(1)

    if is_ssh_remote(remote) and not ssh_reachable(remote, rsync):
        host = remote.split(":", 1)[0]
        print(f"error: cannot reach '{host}' over SSH.")
        print("   Host unreachable, key not loaded (ssh-add), or VPN not connected.")
        print(f"   Try: rsync --list-only {host}:.")
        sys.exit(1)

    if watch:
        raw_interval = parse_flag_value(args, "--interval", None)
        debounce = float(raw_interval) if raw_interval is not None else 2.0
        cmd_watch(repo_root, remote, exclude_patterns, debounce, rsync)
        return

    transport = "ssh" if is_ssh_remote(remote) else "local"

    if file_arg:
        file_path = Path(file_arg)
        try:
            file_path.resolve().relative_to(repo_root)
        except ValueError:
            print(f"error: file is outside the project: {file_path}")
            sys.exit(1)
        print(format_header("dry-run" if dry_run else "file", repo_root.name, remote, transport), flush=True)
        rc = sync_file(file_path, repo_root, remote, dry_run, rsync)
    else:
        exclude_file = write_exclude_file(repo_root, exclude_patterns)
        print(format_header("dry-run" if dry_run else "sync", repo_root.name, remote, transport), flush=True)
        rc = sync_full(repo_root, remote, exclude_file, dry_run, rsync)
        exclude_file.unlink(missing_ok=True)

    if rc != 0:
        print(paint(f"rsync exited with code {rc}", "magenta"))
        sys.exit(rc)


if __name__ == "__main__":
    main()
