def find_config(start: Path) -> tuple[Path, dict] | None:
    """Walk up from start, looking for .xsync.toml. Returns (repo_root, config)."""
    for directory in [start, *start.parents]:
        config_path = directory / ".xsync.toml"
        if config_path.exists():
            with open(config_path, "rb") as f:
                return directory, tomllib.load(f)
    return None


def write_exclude_file(repo_root: Path, patterns: list[str]) -> Path:
    """Write exclude patterns to a temp file rsync can consume."""
    exclude_path = repo_root / ".xsync.exclude"
    exclude_path.write_text("\n".join(patterns) + "\n")
    return exclude_path


HOMEBREW_RSYNC = "/opt/homebrew/bin/rsync"
# Default rsync command prefix: binary plus any extra args from the config
RSYNC = ["rsync"]


def resolve_rsync(config: dict) -> str:
    """Pick the rsync binary: config key, then Homebrew's, then whatever is on PATH."""
    configured = config.get("rsync")
    if configured:
        return os.path.expanduser(configured)
    return HOMEBREW_RSYNC if os.path.exists(HOMEBREW_RSYNC) else "rsync"


def is_gnu_rsync3(version_output: str) -> bool:
    """True if `rsync --version` output looks like GNU rsync 3.x (not openrsync)."""
    if "openrsync" in version_output:
        return False
    return re.match(r"rsync\s+version\s+3\.", version_output) is not None


# Summarize rsync's output instead of passing it through. Needs GNU rsync 3.x;
# switched off by --verbose, the v key, or another rsync flavor.
PRETTY = False
# Number of new, updated and deleted paths sent so far, and the counts of the last rsync run
CHANGES = 0
LAST_COUNTS = {"new": 0, "updated": 0, "deleted": 0}
# Set by run_session(): called with the text of every warning and error
PROBLEM_HOOK = None

COLORS = {
    # 256-color blue and red: the basic ones are too dark on dark terminal themes
    "green": "32", "blue": "38;5;75", "red": "38;5;203", "yellow": "33", "magenta": "35", "dim": "2", "bold": "1",
}


def colors_on() -> bool:
    return sys.stdout.isatty() and "NO_COLOR" not in os.environ


def paint(text: str, color: str | None) -> str:
    """Color text for a terminal; plain when piped or when NO_COLOR is set."""
    if color is None or not colors_on():
        return text
    return f"\033[{COLORS[color]}m{text}\033[0m"


def emit(text: str, color: str | None = None, note: str = ""):
    """Print one time-stamped line in the list below the fixed rows."""
    line = f"{datetime.now():%H:%M:%S}  " + paint(text, color)
    print(line + (paint(f"  ({note})", "dim") if note else ""), flush=True)


def warn(text: str, color: str = "yellow"):
    """Print a warning or error line and hand it to the session, if one is running."""
    emit(f"! {text}", color)
    if PROBLEM_HOOK:
        PROBLEM_HOOK(text)


